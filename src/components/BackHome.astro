---
// A centered "Back to home" button, used at the bottom of a few pages.
import { url } from '../lib/url';
---

<div class="back-home">
  <a class="text-link" href={url('/')}><span class="arrow back" aria-hidden="true"></span>Back to home</a>
</div>

<style>
  .back-home { display: flex; justify-content: center; margin-top: 28px; }
  /* The site's drawn arrow, turned to point back */
  .back { transform: rotate(180deg); }
  @media (hover: hover) and (pointer: fine) { .text-link:hover .back { transform: rotate(180deg) translateX(4px); } }
</style>
