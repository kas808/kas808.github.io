---
// Photo grid. Click a photo to see it full screen; arrows move through the set.
import { Image, getImage } from 'astro:assets';

interface Props {
  title?: string;
  images: { src: ImageMetadata; caption: string }[];
}
const { title, images } = Astro.props;
const items = await Promise.all(
  images.map(async (img) => ({
    ...img,
    full: (await getImage({ src: img.src, width: Math.min(img.src.width, 1800), format: 'webp' })).src,
  })),
);
const cols = images.length === 1 ? 'one' : images.length === 2 || images.length === 4 ? 'two' : 'three';
---

<section class="gallery reveal" data-zoom-group>
  {title && <h2 class="gallery-title">{title}</h2>}
  <ul class:list={['grid', cols]}>
    {items.map((img) => (
      <li data-zoom>
        <figure>
          <a href={img.full}>
            <Image
              src={img.src}
              alt={img.caption}
              data-caption={img.caption}
              widths={[400, 800, 1200]}
              sizes={cols === 'one' ? '(max-width: 900px) 100vw, 900px' : '(max-width: 700px) 100vw, 45vw'}
              loading="lazy"
            />
          </a>
          <figcaption>{img.caption}</figcaption>
        </figure>
      </li>
    ))}
  </ul>
</section>

<style>
  .gallery { margin-block: 40px; }
  .gallery-title { font-size: var(--fs-lead); margin-bottom: 16px; }
  .grid { list-style: none; margin: 0; padding: 0; display: grid; gap: 18px; }
  .grid.one { grid-template-columns: minmax(0, 900px); }
  .grid.two { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .grid.three { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  @media (max-width: 900px) { .grid.three { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 560px) { .grid.two, .grid.three { grid-template-columns: 1fr; } }
  figure { margin: 0; }
  a { display: block; aspect-ratio: 4 / 3; background: var(--white); border: 1px solid var(--mist); border-radius: var(--radius); overflow: hidden; cursor: zoom-in; }
  .grid.one a { aspect-ratio: auto; }
  a :global(img) { width: 100%; height: 100%; object-fit: contain; transition: transform 0.5s var(--ease); }
  a:hover :global(img) { transform: scale(1.03); }
  figcaption { font-size: var(--fs-small); color: var(--steel); margin-top: 8px; }
</style>
