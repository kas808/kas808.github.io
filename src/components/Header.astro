---
// Sticky top bar with Projects and Experience menus.
// The menu builds itself from your content files, so new projects show up automatically.
import ProjectsMenu from './ProjectsMenu.astro';
import { url } from '../lib/url';
import { site } from '../lib/site';

const path = Astro.url.pathname.replace(import.meta.env.BASE_URL.replace(/\/$/, ''), '') || '/';
const active = (prefix: string) => (prefix === '/' ? path === '/' : path.startsWith(prefix));
---

<header class="site-header">
  <div class="bar wrap">
    <a class="brand" href={url('/')}>{site.name}</a>

    <button class="menu-toggle" aria-expanded="false" aria-controls="site-nav">
      <span class="visually-hidden">Menu</span>
      <span class="burger" aria-hidden="true"></span>
    </button>

    <nav id="site-nav" class="nav" aria-label="Main">
      <ul class="nav-list">
        <li><a href={url('/')} aria-current={active('/') ? 'page' : undefined}>Home</a></li>
        <li class="has-menu">
          <div class="split">
            <a href={url('/projects/')} aria-current={active('/projects') || active('/punahou') ? 'page' : undefined}>Projects</a>
            <button class="menu-btn caret-btn" aria-expanded="false" aria-controls="projects-menu">
              <span class="visually-hidden">Show the projects menu</span><span class="caret" aria-hidden="true"></span>
            </button>
          </div>
          <div id="projects-menu" class="mega">
            <div class="mega-inner wrap">
              <ProjectsMenu />
            </div>
          </div>
        </li>
        <li class="has-menu has-drop">
          <button class="menu-btn" aria-expanded="false" aria-controls="experience-menu" data-active={active('/experience') ? '' : undefined}>
            Experience <span class="caret" aria-hidden="true"></span>
          </button>
          <div id="experience-menu" class="mega drop">
            <ul class="drop-list">
              <li><a href={url('/experience/wsp/')}><strong>WSP Internship</strong><span>Mechanical Engineering Intern</span></a></li>
              <li><a href={url('/experience/robotics-ta/')}><strong>Punahou Robotics</strong><span>Robotics Teaching Assistant</span></a></li>
              <li><a href={url('/experience/')}><strong>All experience</strong></a></li>
            </ul>
          </div>
        </li>
        <li><a href={url('/resume/')} aria-current={active('/resume') ? 'page' : undefined}>Resume</a></li>
        <li><a href={url('/contact/')} aria-current={active('/contact') ? 'page' : undefined}>Contact</a></li>
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(241, 240, 236, 0.94);
    backdrop-filter: saturate(1.4) blur(10px);
    -webkit-backdrop-filter: saturate(1.4) blur(10px);
    border-bottom: 1px solid var(--mist);
  }
  .bar { height: var(--header-h); display: flex; align-items: center; justify-content: space-between; gap: 24px; }
  .brand { font-weight: 800; font-size: var(--fs-lead); letter-spacing: -0.02em; color: var(--ink); text-decoration: none; white-space: nowrap; }

  .nav-list { display: flex; align-items: center; gap: 4px; margin: 0; padding: 0; list-style: none; }
  .nav-list > li > a,
  .split > a,
  .menu-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 8px 14px;
    font: 500 var(--fs-small)/1 var(--font);
    color: var(--ink);
    text-decoration: none;
    background: none;
    border: 0;
    cursor: pointer;
    position: relative;
  }
  .nav-list > li > a::after,
  .split > a::after,
  .menu-btn::after {
    content: '';
    position: absolute;
    left: 14px;
    right: 14px;
    bottom: 2px;
    height: 1px;
    background: var(--ink);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.25s var(--ease);
  }
  .nav-list > li > a:hover::after,
  .nav-list > li > a[aria-current]::after,
  .split > a:hover::after,
  .split > a[aria-current]::after,
  .menu-btn:hover::after,
  .menu-btn[data-active]::after { transform: scaleX(1); }

  .caret { width: 7px; height: 7px; border-right: 1.5px solid currentColor; border-bottom: 1.5px solid currentColor; transform: translateY(-2px) rotate(45deg); transition: transform 0.2s var(--ease); }
  .menu-btn[aria-expanded='true'] .caret { transform: translateY(1px) rotate(-135deg); }

  /* Projects: the word is a link to /projects/, the arrow next to it opens the menu */
  .split { display: flex; align-items: center; }
  .split > a { padding-right: 4px; }
  .split > a::after { right: 4px; }
  .caret-btn { padding: 8px 10px 8px 4px; }
  .caret-btn::after { display: none; }
  .menu-btn:focus-visible, .split > a:focus-visible { outline: 2px solid var(--focus-ring); outline-offset: 2px; }

  .mega {
    position: absolute;
    left: 0;
    right: 0;
    top: var(--header-h);
    background: var(--white);
    border-bottom: 1px solid var(--mist);
    box-shadow: 0 24px 40px -24px rgba(37, 52, 71, 0.25);
    opacity: 0;
    visibility: hidden;
    transform: translateY(-6px);
    transition: opacity 0.2s var(--ease), transform 0.2s var(--ease), visibility 0.2s;
    max-height: calc(100vh - var(--header-h));
    overflow-y: auto;
  }
  .has-menu.open .mega { opacity: 1; visibility: visible; transform: none; }
  .mega-inner { padding-block: 28px 36px; }

  /* Small dropdown (Experience) */
  .has-drop { position: relative; }
  .drop { left: 50%; right: auto; top: calc(var(--header-h) - 12px); width: 290px; translate: -50% 0; border: 1px solid var(--mist); border-radius: var(--radius); overflow: hidden; }
  .drop-list { list-style: none; margin: 0; padding: 8px 0; }
  .drop-list a { display: flex; flex-direction: column; gap: 2px; padding: 10px 20px; text-decoration: none; color: var(--ink); }
  .drop-list a:hover { background: var(--paper); }
  .drop-list strong { font-size: var(--fs-small); }
  .drop-list span { font-size: var(--fs-small); color: var(--steel); }

  .menu-toggle { display: none; }

  @media (max-width: 900px) {
    /* The blur effect would trap the full-screen menu inside the bar, so use a solid bar on phones */
    .site-header { backdrop-filter: none; -webkit-backdrop-filter: none; background: var(--paper); }
    .menu-toggle {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 44px;
      height: 44px;
      border: 0;
      background: none;
      cursor: pointer;
    }
    .burger, .burger::before, .burger::after {
      display: block;
      width: 22px;
      height: 1.5px;
      background: var(--ink);
      position: relative;
      transition: transform 0.25s var(--ease), background 0.25s;
    }
    .burger::before, .burger::after { content: ''; position: absolute; left: 0; }
    .burger::before { top: -7px; }
    .burger::after { top: 7px; }
    .menu-toggle[aria-expanded='true'] .burger { background: transparent; }
    .menu-toggle[aria-expanded='true'] .burger::before { transform: translateY(7px) rotate(45deg); }
    .menu-toggle[aria-expanded='true'] .burger::after { transform: translateY(-7px) rotate(-45deg); }

    .nav {
      position: fixed;
      inset: var(--header-h) 0 0 0;
      background: var(--paper);
      overflow-y: auto;
      padding: 12px var(--gutter) 48px;
      display: none;
    }
    .nav.open { display: block; }
    .nav-list { flex-direction: column; align-items: stretch; gap: 0; }
    .nav-list > li { border-bottom: 1px solid var(--mist); }
    .nav-list > li > a, .menu-btn { width: 100%; justify-content: space-between; padding: 16px 0; font-size: var(--fs-body); }
    .nav-list > li > a::after, .menu-btn::after, .split > a::after { display: none; }
    .split > a { flex: 1; padding: 16px 0; font-size: var(--fs-body); }
    .caret-btn { width: 48px; justify-content: center; padding: 16px 0; }
    .mega { position: static; box-shadow: none; border: 0; background: transparent; transform: none; max-height: none; overflow: visible; display: none; opacity: 1; visibility: visible; }
    .has-menu.open .mega { display: block; }
    .mega-inner { padding: 0 0 16px 12px; max-width: none; margin: 0; }
    .drop { width: auto; translate: none; border: 0; }
    .drop-list a { padding: 8px 12px; }
  }
</style>

<script>
  function setup() {
    const header = document.querySelector('.site-header');
    if (!header) return;
    const toggle = header.querySelector<HTMLButtonElement>('.menu-toggle');
    const nav = header.querySelector<HTMLElement>('.nav');
    const items = Array.from(header.querySelectorAll<HTMLElement>('.has-menu'));
    const desktop = window.matchMedia('(min-width: 901px)');

    const setMenu = (item: HTMLElement, open: boolean) => {
      item.classList.toggle('open', open);
      item.querySelector('.menu-btn')?.setAttribute('aria-expanded', String(open));
    };
    const closeAll = (except?: HTMLElement) => items.forEach((i) => i !== except && setMenu(i, false));

    toggle?.addEventListener('click', () => {
      const open = !nav?.classList.contains('open');
      nav?.classList.toggle('open', open);
      toggle.setAttribute('aria-expanded', String(open));
      document.body.style.overflow = open ? 'hidden' : '';
    });

    items.forEach((item) => {
      const btn = item.querySelector<HTMLButtonElement>('.menu-btn');
      btn?.addEventListener('click', () => {
        const open = !item.classList.contains('open');
        if (desktop.matches) closeAll(item);
        setMenu(item, open);
      });
      let timer: number | undefined;
      item.addEventListener('mouseenter', () => { if (desktop.matches) { clearTimeout(timer); closeAll(item); setMenu(item, true); } });
      item.addEventListener('mouseleave', () => { if (desktop.matches) timer = window.setTimeout(() => setMenu(item, false), 180); });
    });

    // Esc closes an open menu and puts the keyboard focus back on its button
    document.addEventListener('keydown', (e) => {
      if (e.key !== 'Escape') return;
      const open = items.find((i) => i.classList.contains('open'));
      closeAll();
      if (open) open.querySelector<HTMLButtonElement>('.menu-btn')?.focus();
    });
    document.addEventListener('click', (e) => {
      if (desktop.matches && !items.some((i) => i.contains(e.target as Node))) closeAll();
    });
  }
  setup();
</script>
