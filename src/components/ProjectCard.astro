---
// One project tile: photo, a label line, the title in the serif, and a "Read the project" link.
import { Image } from 'astro:assets';
import { url } from '../lib/url';

interface Props {
  href: string;
  title: string;
  summary?: string;
  meta?: string;
  cover?: ImageMetadata;
  coverAlt?: string;
  coverPosition?: string;
  coverFit?: 'cover' | 'contain';
  tools?: string[];
  status?: string;
  size?: 'large' | 'small';
  label?: string; // shown on cards that have no photo
}
const { href, title, summary, meta, cover, coverAlt = '', coverPosition, coverFit, tools = [], status, size = 'large', label } = Astro.props;
---

<article class:list={['card', `card-${size}`, 'reveal']}>
  <a class="card-media" href={url(href)} tabindex="-1" aria-hidden="true" style={[coverPosition && `--pos: ${coverPosition}`, coverFit && `--fit: ${coverFit}`].filter(Boolean).join('; ') || undefined}>
    {cover ? (
      <Image src={cover} alt={coverAlt} widths={[400, 700, 1000]} sizes={size === 'large' ? '(max-width: 700px) 100vw, 50vw' : '(max-width: 700px) 100vw, 33vw'} loading="lazy" />
    ) : (
      <div class="blueprint"><span>{label ?? title}</span></div>
    )}
    {status === 'in progress' && <span class="status card-status">In progress</span>}
  </a>
  <div class="card-body">
    {meta && <p class="eyebrow">{meta}</p>}
    <h3><a href={url(href)}>{title}</a></h3>
    {summary && <p class="summary">{summary}</p>}
    {size === 'large' && tools.length > 0 && (
      <ul class="tags">{tools.slice(0, 5).map((t) => <li>{t}</li>)}</ul>
    )}
    <a class="text-link" href={url(href)}>Read the project<span class="visually-hidden">: {title}</span> <span class="arrow" aria-hidden="true"></span></a>
  </div>
</article>

<style>
  /* Flat on the paper, like the home page: the photo, a mono label line, the title in the serif */
  .card { position: relative; display: flex; flex-direction: column; }
  .card-media { position: relative; display: block; aspect-ratio: 4 / 3; overflow: hidden; background: var(--paper-up); }
  .card-small .card-media { aspect-ratio: 16 / 10; }
  .card-media[style*='contain'] { background: #fff; }
  .card-media :global(img) { width: 100%; height: 100%; object-fit: var(--fit, cover); object-position: var(--pos, 50% 50%); transition: transform 0.8s var(--ease), filter 0.5s ease; }
  /* Mouse: photos rest a little muted and come up to full colour on hover, like the tiles on the home page */
  @media (hover: hover) and (pointer: fine) {
    .card-media :global(img) { filter: saturate(0.55) brightness(0.94); }
    .card:hover .card-media :global(img) { filter: none; transform: scale(1.035); }
    .card:hover h3 a { text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 5px; }
  }
  .card-status { position: absolute; top: 12px; left: 12px; }
  .card-body { display: flex; flex-direction: column; gap: 10px; padding: 18px 0 8px; flex: 1; border-top: 1px solid var(--ink); margin-top: 14px; }
  .card-body .eyebrow { margin: 0; }
  .card-body h3 { margin: 0; font-size: clamp(1.5rem, 1.1rem + 1vw, 2rem); }
  .card-body h3 a { color: var(--ink); text-decoration: none; }
  .summary { margin: 0; font-size: var(--fs-body); color: var(--charcoal); }
  .card-small .summary { font-size: var(--fs-small); }
  .card-body .text-link { margin-top: auto; align-self: flex-start; }
  .card-body .tags { margin-bottom: 6px; }

  /* No photo yet: a graphite plate with the project's name in mono */
  .blueprint { width: 100%; height: 100%; display: flex; align-items: flex-end; padding: 18px; background: var(--graphite); }
  .blueprint span { font-family: var(--mono); font-size: var(--fs-label); text-transform: uppercase; letter-spacing: 0.04em; color: #d8d3c9; }
</style>
