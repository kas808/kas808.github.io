---
// The layout of every project page (used by src/pages/projects/[slug].astro).
// Content comes from src/content/projects/<folder>/index.md, so you never
// need to edit this file to add a project.
import { Image } from 'astro:assets';
import { render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Gallery from './Gallery.astro';
import VideoPlayer from './VideoPlayer.astro';
import Documents from './Documents.astro';
import SkillChips from './SkillChips.astro';
import { pageCategories } from '../lib/category-cards';
import { url } from '../lib/url';

interface Props {
  entry: CollectionEntry<'projects'>;
  prev?: CollectionEntry<'projects'>;
  next?: CollectionEntry<'projects'>;
}

const { entry, prev, next } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
const media = (file: string) => `/media/${entry.id}/${file}`;
---

<BaseLayout title={d.title} description={d.summary} type="article">
  <article>
    <header class="project-head wrap">
      <nav class="crumbs" aria-label="Breadcrumb"><a href={url('/projects/')}>Projects</a> <span>/</span> {d.title}</nav>
      <p class="eyebrow">{[d.course, d.date].filter(Boolean).join(' · ')}</p>
      <h1>{d.title}</h1>
      {d.status === 'in progress' && <p><span class="status">In progress</span></p>}
      <div class="skill-tags"><SkillChips small label="Skill areas" only={pageCategories(d)} /></div>
      <p class="lead">{d.summary}</p>
    </header>

    {d.cover && (
      <div class="wrap">
        <div class="cover">
          <Image src={d.cover} alt={d.coverAlt ?? ''} widths={[600, 1000, 1400, 1800]} sizes="(max-width: 1200px) 100vw, 1200px" loading="eager" />
        </div>
      </div>
    )}

    <div class="wrap body-grid">
      <aside class="facts reveal" aria-label="Project details">
        <dl>
          <dt>My role</dt>
          <dd>{d.role}</dd>
          {d.team && (<><dt>Team</dt><dd>{d.team}</dd></>)}
          {d.course && (<><dt>Course</dt><dd>{d.course}</dd></>)}
          <dt>Date</dt>
          <dd>{d.date}</dd>
          <dt>Tools and skills</dt>
          <dd><ul class="tags">{d.tools.map((t) => <li>{t}</li>)}</ul></dd>
        </dl>
      </aside>

      <div class="main-col">
        {d.video && <VideoPlayer src={media(d.video.file)} poster={d.video.poster && media(d.video.poster)} caption={d.video.caption} />}
        <div class="prose reveal">
          <Content />
        </div>
      </div>
    </div>

    <div class="wrap">
      {d.gallery.map((g) => <Gallery title={g.title} images={g.images} />)}
      <Documents folder={entry.id} documents={d.documents} />
    </div>

    <nav class="pager wrap" aria-label="More projects">
      {prev ? <a class="prev" href={url(`/projects/${prev.id}/`)}><span class="eyebrow">Previous</span>{prev.data.title}</a> : <span />}
      {next ? <a class="next" href={url(`/projects/${next.id}/`)}><span class="eyebrow">Next</span>{next.data.title}</a> : <span />}
    </nav>
  </article>
</BaseLayout>

<style>
  .project-head { padding-block: clamp(40px, 7vw, 96px) 32px; }
  .project-head h1 { max-width: 18ch; }
  .project-head .lead { margin-top: 0.5em; }
  .crumbs { font-family: var(--mono); font-size: var(--fs-label); text-transform: uppercase; letter-spacing: 0.04em; color: var(--steel); margin-bottom: 28px; }
  .crumbs a { color: var(--steel); }
  .cover { overflow: hidden; background: #fff; border: 1px solid var(--mist); }
  .cover :global(img) { width: 100%; max-height: 74vh; object-fit: contain; }

  .body-grid { display: grid; grid-template-columns: 300px minmax(0, 1fr); gap: clamp(32px, 5vw, 72px); margin-top: 56px; align-items: start; }
  @media (max-width: 900px) { .body-grid { grid-template-columns: 1fr; } }
  /* Project facts as a drawing title block: ruled cells, labels in mono capitals */
  .facts { position: sticky; top: calc(var(--header-h) + 24px); border-top: 1.5px solid var(--ink); }
  @media (max-width: 900px) { .facts { position: static; } }
  .facts dl { margin: 0; display: grid; border-left: 1px solid var(--mist); }
  .facts dt, .facts dd { border-right: 1px solid var(--mist); padding-inline: 14px; }
  .facts dt { padding-top: 12px; font-family: var(--mono); font-size: var(--fs-label); text-transform: uppercase; letter-spacing: 0.04em; color: var(--steel); }
  .facts dd { margin: 0; padding-top: 4px; padding-bottom: 14px; border-bottom: 1px solid var(--mist); font-size: var(--fs-body); color: var(--ink); }
  .facts .tags { margin-top: 6px; }

  .pager { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; padding-block: 56px 88px; margin-top: 48px; border-top: 1px solid var(--mist); }
  .pager a { display: flex; flex-direction: column; gap: 8px; text-decoration: none; font-family: var(--serif); font-optical-sizing: auto; font-weight: 380; font-size: clamp(1.5rem, 1.1rem + 1.4vw, 2.5rem); line-height: 1.05; letter-spacing: -0.02em; color: var(--ink); }
  .pager .eyebrow { margin: 0; font-family: var(--mono); }
  .pager .next { text-align: right; align-items: flex-end; }
  @media (hover: hover) and (pointer: fine) { .pager a:hover { font-style: italic; } }
  .skill-tags { margin-top: 18px; }
  .skill-tags:empty { display: none; }
</style>
