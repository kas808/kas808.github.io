---
// The frame every page sits inside: <head>, top bar, footer,
// the click-to-enlarge photo viewer, and the scroll-in animation.
import '@fontsource-variable/archivo/wdth.css';
import '@fontsource-variable/newsreader/opsz.css';
import '@fontsource-variable/newsreader/opsz-italic.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ResumeViewer from '../components/ResumeViewer.astro';
import { site } from '../lib/site';
import { url } from '../lib/url';
import { ogFile, ogPages } from '../lib/og';
import { shortDescription } from '../lib/og-image';

interface Props {
  title?: string;
  description?: string;
  type?: 'website' | 'article'; // 'article' for project and experience pages
  noindex?: boolean; // keep a page out of search results
}
const { title, description: longDescription = site.description, type = 'website', noindex = false } = Astro.props;
const fullTitle = title ? `${title} | ${site.name}` : site.title;
const canonical = new URL(Astro.url.pathname, Astro.site);
// Link previews: the description is trimmed to about 155 characters, and the
// picture is the one made for this page in src/lib/og.ts (the build stops if one is missing)
const description = shortDescription(longDescription);
const pageKey = Astro.url.pathname.slice(import.meta.env.BASE_URL.length - 1).replace(/\.html$/, '').replace(/^\/+|\/+$/g, '');
if (!(await ogPages()).some((p) => p.key === pageKey)) {
  throw new Error(`No link preview picture for the page "/${pageKey}". Add it to src/lib/og.ts.`);
}
const ogImage = new URL(url(`/og/${ogFile(pageKey)}`), Astro.site);
---

<!doctype html>
<html lang="en" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
    <meta name="theme-color" content="#f3efe7" />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:type" content={type} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title ? `${title}, from the portfolio of ${site.name}` : `${site.name}, mechanical engineer`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <script is:inline>document.documentElement.classList.remove('no-js');</script>
  </head>
  <body>
    <a class="skip-link btn" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <button class="float-top" type="button" aria-label="Back to top" data-float-top>
      <span class="ft-arrow" aria-hidden="true"></span>
    </button>

    <ResumeViewer />

    <dialog class="lightbox" aria-label="Enlarged image">
      <button class="lb-close" aria-label="Close">×</button>
      <button class="lb-prev" aria-label="Previous image">‹</button>
      <figure>
        <img alt="" />
        <figcaption></figcaption>
      </figure>
      <button class="lb-next" aria-label="Next image">›</button>
    </dialog>

    <style is:global>
      .lightbox {
        width: 100vw; height: 100vh; max-width: none; max-height: none;
        margin: 0; padding: 0; border: 0;
        background: rgba(21, 21, 21, 0.95);
        color: #fff;
      }
      .lightbox[open] { display: flex; align-items: center; justify-content: center; }
      .lightbox::backdrop { background: transparent; }
      .lightbox figure { margin: 0; max-width: min(92vw, 1600px); display: flex; flex-direction: column; align-items: center; gap: 12px; }
      .lightbox img { max-height: 82vh; width: auto; max-width: 100%; object-fit: contain; border-radius: 2px; background: #fff; }
      .lightbox figcaption { font-family: var(--mono); font-size: var(--fs-label); color: #d8d3c9; text-align: center; max-width: 70ch; }
      .lightbox button {
        position: absolute; background: none; border: 0; color: #fff; cursor: pointer;
        font-size: 2.6rem; line-height: 1; padding: 12px 18px; opacity: 0.8;
      }
      .lightbox button:hover { opacity: 1; }
      .lb-close { top: 8px; right: 8px; }
      .lb-prev { left: 4px; top: 50%; transform: translateY(-50%); }
      .lb-next { right: 4px; top: 50%; transform: translateY(-50%); }
      .lightbox.single .lb-prev, .lightbox.single .lb-next { display: none; }

      /* Floating back-to-top button: shows up after scrolling down a bit */
      .float-top {
        position: fixed; right: clamp(16px, 3vw, 32px); bottom: clamp(16px, 3vw, 32px); z-index: 40;
        width: 48px; height: 48px; display: grid; place-items: center;
        background: var(--ink); color: var(--paper); border: 1px solid rgba(243, 239, 231, 0.25);
        border-radius: 0; cursor: pointer;
        opacity: 0; visibility: hidden; transform: translateY(10px);
        transition: opacity 0.25s var(--ease), transform 0.25s var(--ease), visibility 0.25s, background 0.2s var(--ease);
      }
      .float-top.show { opacity: 1; visibility: visible; transform: none; }
      .float-top:hover { background: var(--ink-soft); }
      .ft-arrow { width: 10px; height: 10px; border-left: 2px solid currentColor; border-top: 2px solid currentColor; transform: translateY(3px) rotate(45deg); }
    </style>

    <script>
      // Fade sections in as they scroll into view.
      const io = new IntersectionObserver(
        (entries) => entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('is-visible'); io.unobserve(e.target); } }),
        { rootMargin: '0px 0px -8% 0px', threshold: 0.08 },
      );
      document.querySelectorAll('.reveal').forEach((el) => io.observe(el));

      // Click any gallery photo (or image in project text) to see it full screen.
      const dialog = document.querySelector<HTMLDialogElement>('.lightbox')!;
      const big = dialog.querySelector('img')!;
      const cap = dialog.querySelector('figcaption')!;
      let set: HTMLImageElement[] = [];
      let index = 0;

      const show = (i: number) => {
        index = (i + set.length) % set.length;
        const img = set[index];
        const full = img.closest('a')?.getAttribute('href') || img.currentSrc || img.src;
        big.src = full;
        big.alt = img.alt;
        cap.textContent = img.dataset.caption || img.alt || '';
      };

      document.addEventListener('click', (e) => {
        const img = (e.target as HTMLElement).closest<HTMLImageElement>('[data-zoom] img, .prose img');
        if (!img || img.closest('.yt-embed')) return;
        e.preventDefault();
        const scope = img.closest('[data-zoom-group]') || img.closest('.prose') || document;
        set = Array.from(scope.querySelectorAll<HTMLImageElement>('[data-zoom] img, .prose img')).filter((i) => !i.closest('.yt-embed'));
        dialog.classList.toggle('single', set.length < 2);
        show(set.indexOf(img));
        dialog.showModal();
      });
      dialog.querySelector('.lb-close')!.addEventListener('click', () => dialog.close());
      dialog.querySelector('.lb-prev')!.addEventListener('click', () => show(index - 1));
      dialog.querySelector('.lb-next')!.addEventListener('click', () => show(index + 1));
      dialog.addEventListener('click', (e) => { if (e.target === dialog) dialog.close(); });
      // Floating back-to-top button
      const topBtn = document.querySelector<HTMLButtonElement>('[data-float-top]')!;
      const toggleTop = () => topBtn.classList.toggle('show', window.scrollY > 700);
      window.addEventListener('scroll', toggleTop, { passive: true });
      toggleTop();
      topBtn.addEventListener('click', () => {
        const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        window.scrollTo({ top: 0, behavior: reduce ? 'auto' : 'smooth' });
        (document.querySelector('.brand') as HTMLElement | null)?.focus({ preventScroll: true });
      });

      // YouTube: show a thumbnail, load the real player only when clicked.
      document.querySelectorAll<HTMLElement>('.yt-embed[data-yt]').forEach((box) => {
        const id = box.dataset.yt!;
        const title = box.dataset.title || 'YouTube video';
        const btn = document.createElement('button');
        btn.className = 'yt-thumb';
        btn.setAttribute('aria-label', `Play video: ${title}`);
        btn.innerHTML = `<img src="https://i.ytimg.com/vi/${id}/hqdefault.jpg" alt="" loading="lazy"><span class="yt-play" aria-hidden="true"></span><span class="yt-title">${title}</span>`;
        btn.addEventListener('click', () => {
          box.innerHTML = `<iframe src="https://www.youtube-nocookie.com/embed/${id}?autoplay=1&rel=0" title="${title}" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>`;
        });
        box.replaceChildren(btn);
      });

      dialog.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowLeft') show(index - 1);
        if (e.key === 'ArrowRight') show(index + 1);
      });
    </script>
  </body>
</html>
