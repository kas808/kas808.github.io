---
import BaseLayout from '../layouts/BaseLayout.astro';
import { url } from '../lib/url';
---

<BaseLayout title="Page not found">
  <section class="page-head wrap" style="padding-bottom: 120px">
    <h1>Page not found.</h1>
    <p class="lead">That page doesn't exist. It may have moved when this site replaced my old Google Site.</p>
    <div class="btn-row">
      <a class="btn" href={url('/')}>Home</a>
      <a class="btn btn-ghost" href={url('/projects/')}>Projects</a>
    </div>
  </section>
</BaseLayout>
