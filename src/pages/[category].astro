---
// The skill pages used to live at /<skill>/ (like /thermal/). They now live on
// the Projects page at /projects/<skill>/, so these old addresses forward there.
import { categories, type Category } from '../lib/categories';
import { url } from '../lib/url';
import { site } from '../lib/site';
import { ogFile } from '../lib/og';
import { shortDescription } from '../lib/og-image';

export function getStaticPaths() {
  return categories.map((c) => ({ params: { category: c.slug }, props: { cat: c } }));
}
const { cat } = Astro.props as { cat: Category };
const to = url(`/projects/${cat.slug}/`);
const full = new URL(to, Astro.site);
const title = `${cat.name} Projects | ${site.name}`;
const description = shortDescription(cat.intro);
const image = new URL(url(`/og/${ogFile(`projects/${cat.slug}`)}`), Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>{title}</title>
    <meta http-equiv="refresh" content={`0; url=${to}`} />
    <link rel="canonical" href={full} />
    <meta name="robots" content="noindex" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#253447" />
    <!-- Old links still get the right preview -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={full} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
  </head>
  <body>
    <p>This page moved to <a href={to}>{cat.name} Projects</a>.</p>
  </body>
</html>
