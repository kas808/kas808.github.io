---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { url } from '../../lib/url';

const jobs = (await getCollection('experience')).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout title="Experience" description="Engineering experience of Kasin Ito-Sato: mechanical engineering internship at WSP and robotics teaching at Punahou School.">
  <header class="page-head wrap">
    <h1>Experience</h1>
    <p class="lead">Work outside the classroom, from HVAC design at an engineering firm to teaching younger students robotics.</p>
  </header>

  <section class="wrap jobs">
    {jobs.map((job) => (
      <a class="job reveal" href={url(`/experience/${job.id}/`)}>
        <span class="job-img" style={`--pos: ${job.data.coverPosition ?? '50% 50%'}`}>
          <Image src={job.data.cover} alt={job.data.coverAlt} widths={[600, 1000, 1400]} sizes="(max-width: 900px) 100vw, 60vw" />
        </span>
        <span class="job-text">
          <span class="eyebrow">{job.data.organization} · {job.data.location} · {job.data.dates}</span>
          <span class="job-title">{job.data.title}</span>
          <span class="job-sum">{job.data.summary}</span>
          <span class="text-link">See the {job.id === 'wsp' ? 'internship' : 'role'} <span class="arrow" aria-hidden="true"></span></span>
        </span>
      </a>
    ))}
  </section>
</BaseLayout>

<style>
  /* Each role: photo beside its text, flat on the paper with a ruled top, like the project cards */
  .jobs { display: grid; gap: clamp(48px, 6vw, 80px); padding-bottom: 96px; }
  .job { display: grid; grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr); gap: clamp(24px, 4vw, 56px); align-items: start; text-decoration: none; color: var(--charcoal); }
  @media (max-width: 860px) { .job { grid-template-columns: 1fr; } }
  .job-img { display: block; aspect-ratio: 16 / 10; overflow: hidden; background: var(--paper-up); }
  .job-img :global(img) { width: 100%; height: 100%; object-fit: cover; object-position: var(--pos); transition: transform 0.8s var(--ease), filter 0.5s ease; }
  @media (hover: hover) and (pointer: fine) {
    .job-img :global(img) { filter: saturate(0.55) brightness(0.94); }
    .job:hover .job-img :global(img) { filter: none; transform: scale(1.03); }
    .job:hover .text-link { text-decoration: underline; text-underline-offset: 6px; }
    .job:hover .text-link .arrow { transform: translateX(4px); }
  }
  .job-text { display: flex; flex-direction: column; gap: 14px; padding-top: 16px; border-top: 1px solid var(--ink); }
  .job-text .eyebrow { margin: 0; }
  .job-title { font-family: var(--serif); font-optical-sizing: auto; font-size: var(--fs-heading); font-weight: 380; color: var(--ink); line-height: 1.02; letter-spacing: -0.025em; }
  .job-sum { font-size: var(--fs-body); }
  .job-text .text-link { margin-top: 4px; }
</style>
