      const bar = document.querySelector<HTMLElement>('.bar')!;
      const intro = document.querySelector<HTMLElement>('.intro')!;
      new IntersectionObserver(([e]) => bar.classList.toggle('is-solid', e.boundingClientRect.top <= 72), {
        rootMargin: '-72px 0px 0px 0px', threshold: [0, 1],
      }).observe(intro);

      // Phone menu: opens over the page; Esc, the button again, or choosing a link closes it
      const menuBtn = document.querySelector<HTMLButtonElement>('.menu-btn')!;
      const menu = document.querySelector<HTMLElement>('#phone-menu')!;
      const setMenu = (open: boolean) => {
        menu.hidden = !open;
        menuBtn.setAttribute('aria-expanded', String(open));
        menuBtn.textContent = open ? 'Close' : 'Menu';
        bar.classList.toggle('menu-open', open);
        document.body.style.overflow = open ? 'hidden' : '';
        if (open) menu.querySelector('a')?.focus();
      };
      menuBtn.addEventListener('click', () => setMenu(menu.hidden));
      menu.addEventListener('click', (e) => { if ((e.target as HTMLElement).closest('a')) setMenu(false); });
      document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !menu.hidden) { setMenu(false); menuBtn.focus(); } });
      matchMedia('(min-width: 961px)').addEventListener('change', (e) => { if (e.matches) setMenu(false); });

      // Section parts: rise in as they arrive, a little after one another;
      // anything the visitor jumped past (a link or a fast fling) shows at once
      document.querySelectorAll<HTMLElement>('section, .tiles').forEach((group) => {
        group.querySelectorAll<HTMLElement>(':scope [data-rise], :scope [data-reveal]').forEach((el, i) => {
          if (!el.style.getPropertyValue('--d')) el.style.setProperty('--d', `${Math.min(i, 5) * 70}ms`);
        });
      });
      const riseIO = new IntersectionObserver(
        (entries) => entries.forEach((e) => {
          if (!e.isIntersecting && e.boundingClientRect.top > 0) return;
          e.target.classList.add('in');
          riseIO.unobserve(e.target);
        }),
        { threshold: 0 },
      );
      document.querySelectorAll('[data-rise], [data-reveal]').forEach((el) => riseIO.observe(el));

      // Everything: the preview photo follows the row under the pointer or keyboard focus
      const previewImg = document.querySelector<HTMLImageElement>('[data-preview-img]');
      const previewCap = document.querySelector<HTMLElement>('[data-preview-cap]');
      document.querySelectorAll<HTMLAnchorElement>('.rows a').forEach((row) => {
        const swap = () => {
          const img = row.querySelector<HTMLImageElement>('.row-photo img');
          if (!previewImg || !previewCap || !img) return;
          previewImg.srcset = img.srcset;
          previewImg.src = img.currentSrc || img.src;
          previewImg.style.objectPosition = getComputedStyle(img).objectPosition;
          previewCap.textContent = row.querySelector('.row-name')!.textContent;
        };
        row.addEventListener('mouseenter', swap);
        row.addEventListener('focus', swap);
      });

      // Everything: pick a field to show only its work, in place. Without JavaScript these are links to each field's page.
      const ledger = document.querySelector<HTMLElement>('.ledger');
      if (ledger) {
        const chips = Array.from(ledger.querySelectorAll<HTMLAnchorElement>('[data-field]'));
        const rows = Array.from(ledger.querySelectorAll<HTMLLIElement>('.rows li'));
        const count = ledger.querySelector<HTMLElement>('[data-count]')!;
        const more = ledger.querySelector<HTMLAnchorElement>('[data-field-link]')!;
        const moreLabel = more.firstChild!;
        const allHref = more.getAttribute('href')!;
        chips.forEach((chip) =>
          chip.addEventListener('click', (e) => {
            e.preventDefault();
            const field = chip.dataset.field!;
            chips.forEach((c) => c.setAttribute('aria-current', String(c === chip)));
            let shown = 0;
            rows.forEach((r) => {
              const match = !field || r.dataset.fields!.split(' ').includes(field);
              r.hidden = !match;
              r.classList.remove('is-fresh');
              if (match) {
                r.style.setProperty('--rd', `${Math.min(shown, 8) * 25}ms`);
                void r.offsetWidth; // restart the rise for rows that were already showing
                r.classList.add('is-fresh');
                shown++;
              }
            });
            const name = chip.textContent!.trim();
            count.textContent = field ? `${shown} in ${name}` : `${shown} projects and roles`;
            moreLabel.textContent = field ? `See the ${name} page ` : 'See all projects with photos ';
            more.setAttribute('href', field ? chip.getAttribute('href')! : allHref);
          }),
        );
      }
    </script>
  </body>
</html>
