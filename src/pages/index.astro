---
import { Image } from 'astro:assets';
import { getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import SkillChips from '../components/SkillChips.astro';
import { url } from '../lib/url';
import { site } from '../lib/site';
import { featured, punahou } from '../lib/featured';
import headshot from '../assets/headshot.jpg';
// Hero photos, shown in this order with a quick wipe between them
import heroLanakila from '../assets/hero/lanakila-express.jpg';
import heroWsp from '../assets/hero/wsp-site-visit.jpg';
import heroPantograph from '../assets/hero/pantograph.jpg';
import heroShop from '../assets/hero/shop.jpg';
import heroRope from '../content/projects/rope-climbing-robot/02_robot_on_rope.jpg';
import heroRube from '../assets/hero/rube-goldberg.jpg';
import heroKart from '../assets/hero/go-kart.jpg';
import wspTeam from '../content/experience/wsp/00_wsp_team.jpg';
import wspSite from '../content/experience/wsp/ulana_03.jpg';
import wspPlan from '../content/experience/wsp/spa_plan_04.jpg';
import wspExcel from '../content/experience/wsp/building-pressurization-excel-sheet-walk-through.jpg';

// LMU and WSP work first; Punahou photos come last.
// `position` picks which part of the photo stays in view ('50% 0%' = top, '50% 50%' = middle).
const heroSlides = [
  { src: heroWsp, caption: 'WSP site visit', position: '50% 45%' },
  { src: heroPantograph, caption: '2x Magnifying Pantograph', position: '50% 55%' },
  { src: heroRope, caption: 'Rope Climbing Robot', position: '50% 40%' },
  { src: heroShop, caption: 'In the shop', position: '50% 45%' },
  { src: heroRube, caption: 'Rube Goldberg Machine', position: '50% 45%' },
  { src: heroLanakila, caption: 'Lanakila Express, Punahou School', position: '50% 62%' },
  { src: heroKart, caption: 'Go-Kart, Punahou School', position: '50% 50%' },
];
const pad = (n: number) => String(n).padStart(2, '0');

// Featured projects: title, summary, course, date and photo from each project's index.md,
// plus the measured result from src/lib/featured.ts
const featuredCards = await Promise.all(
  featured.map(async (f) => {
    const entry = await getEntry('projects', f.slug);
    if (!entry) throw new Error(`Featured project "${f.slug}" not found in src/content/projects/`);
    return { ...f, ...entry.data, href: `/projects/${f.slug}/` };
  }),
);
---

<BaseLayout>
  <section class="hero" aria-label="Introduction" data-hero>
    <div class="slides" aria-hidden="true">
      {heroSlides.map((h, i) => (
        <div class:list={['slide-frame', i === 0 && 'is-active']} style={`--pos: ${h.position}`} data-caption={h.caption}>
          <Image src={h.src} alt="" widths={[900, 1400, 2000, 2400]} sizes="100vw" loading={i === 0 ? 'eager' : 'lazy'} fetchpriority={i === 0 ? 'high' : 'auto'} />
        </div>
      ))}
    </div>
    <div class="shade" aria-hidden="true"></div>
    <!-- Slideshow bar: pause button, which photo this is, and a line that fills until the next one -->
    <div class="slide-bar">
      <button class="slide-pause" type="button" aria-label="Pause slideshow" hidden>
        <svg class="i-pause" viewBox="0 0 16 16" aria-hidden="true"><rect x="3.5" y="2.5" width="3" height="11" rx="0.5" /><rect x="9.5" y="2.5" width="3" height="11" rx="0.5" /></svg>
        <svg class="i-play" viewBox="0 0 16 16" aria-hidden="true"><path d="M4.5 2.6v10.8a.5.5 0 0 0 .76.43l8.6-5.4a.5.5 0 0 0 0-.86l-8.6-5.4a.5.5 0 0 0-.76.43Z" /></svg>
      </button>
      <p class="slide-caption">
        <span class="slide-count" aria-hidden="true"><span data-count>01</span> / {pad(heroSlides.length)}</span>
        <span data-caption-text>{heroSlides[0].caption}</span>
      </p>
      <span class="slide-progress" aria-hidden="true"></span>
    </div>
    <div class="wrap hero-content">
      <h1>Kasin Ito-Sato</h1>
      <p class="role">Mechanical Engineer</p>
      <p class="school">BS Mechanical Engineering, <span class="nowrap">Loyola Marymount University</span><span class="sep"> · </span><span class="nowrap">May 2027</span></p>
      <p class="focus">Mechanical design · Thermal & flow analysis · Assembly & test · GD&T</p>
      <!-- One main action; the resume and LinkedIn are plain links beside it -->
      <div class="hero-btns">
        <a class="btn" href={url('/projects/')}>See my projects</a>
        <a class="text-link" href={url('/resume/')}>Resume <span class="arrow" aria-hidden="true"></span></a>
        <a class="text-link" href={site.linkedin} target="_blank" rel="noopener">LinkedIn <span class="arrow" aria-hidden="true"></span></a>
      </div>
    </div>
  </section>

  <section class="about wrap" aria-labelledby="about-title">
    <div class="about-photo reveal">
      <!-- Larger sizes and higher quality than other photos, so the headshot stays sharp on high-resolution screens -->
      <Image src={headshot} alt="Portrait of Kasin Ito-Sato" widths={[480, 720, 1000, 1337]} sizes="(max-width: 860px) 80vw, 40vw" quality={92} />
    </div>
    <div class="about-text reveal">
      <h2 id="about-title">About</h2>
      <div class="about-copy">
        <p>
          I'm a fourth-year mechanical engineering student at Loyola Marymount University, graduating in May 2027, and I'm on
          our team for the 2027 SAE Aero Design Regular Class competition. I grew up on Oahu, where I spent most of my free
          time in the Punahou School engineering shop learning to machine, weld, and wire.
        </p>
        <p>
          What I enjoy most is figuring out why a system behaves the way it does, then building it, testing it, and adjusting
          until it works. After I graduate, I'm looking for a full-time role where I can keep doing that.
        </p>
      </div>
      <p class="facts-row">Los Angeles, CA · FE Mechanical Exam, Nov 2026 · English & Japanese</p>
      <div class="btn-row about-cta">
        <a class="btn" href={url('/resume/')}>Resume</a>
        <a class="btn btn-ghost" href={`mailto:${site.email}`}>Email me</a>
      </div>
    </div>
  </section>

  <section class="featured section-tight" aria-labelledby="featured-title">
    <div class="wrap">
      <div class="featured-head">
        <h2 id="featured-title">Featured Projects</h2>
        <a class="all-link" href={url('/projects/')}>All projects <span class="arrow" aria-hidden="true"></span></a>
      </div>
      <ul class="featured-grid">
        {featuredCards.map((f) => (
          <li class="fcard reveal">
            <a class="fcard-media" href={url(f.href)} tabindex="-1" aria-hidden="true" style={f.coverPosition && `--pos: ${f.coverPosition}`}>
              {f.cover && <Image src={f.cover} alt={f.coverAlt ?? ''} widths={[400, 700, 1000]} sizes="(max-width: 600px) 100vw, (max-width: 960px) 40vw, 33vw" />}
            </a>
            <div class="fcard-body">
              <h3><a href={url(f.href)}>{f.title}</a></h3>
              <p class="fcard-meta">{[f.course, f.date].filter(Boolean).join(' · ')}</p>
              <p class="fcard-summary">{f.summary}</p>
              <dl class="results">
                {f.results.map((r) => (
                  <div>
                    <dt>{r.label}</dt>
                    <dd>{r.value}</dd>
                  </div>
                ))}
              </dl>
              <p class="results-note">{f.note}</p>
            </div>
          </li>
        ))}
      </ul>
      <div class="browse"><SkillChips label="Browse by skill" /></div>
    </div>
  </section>

  <section class="section wrap wsp" aria-labelledby="wsp-title">
    <div class="wsp-grid">
      <a class="wsp-photo reveal" href={url('/experience/wsp/')} tabindex="-1">
        <Image src={wspTeam} alt="Kasin with the WSP Honolulu intern class and a mentor in the office" widths={[600, 900, 1300]} sizes="(max-width: 900px) 100vw, 55vw" />
      </a>
      <div class="wsp-text reveal">
        <h2 id="wsp-title">Mechanical Engineering Intern at WSP</h2>
        <p class="wsp-meta">Internship · Honolulu, HI · May 2025 to January 2026</p>
        <p>
          During my internship at WSP, I worked with licensed mechanical engineers to design HVAC, plumbing, and fire
          protection systems for commercial and residential projects. I performed load calculations and drafting, and
          researched ASHRAE 62.1 and 90.1 standards, IECC codes, and industry practices to apply them to real project
          conditions.
        </p>
        <p>
          I gained experience using Revit, AutoCAD, TRACE 700, IES-VE, and Bluebeam to develop, revise, and
          coordinate mechanical system drawings, BIM documentation, and project submittals. I also created custom Excel
          sheets that looked at demand-controlled ventilation, building pressurization, and exhaust airflow requirements.
        </p>
        <!-- The same software as the paragraph above, as tags a reviewer can scan -->
        <ul class="tags wsp-tools" aria-label="Software used at WSP">
          {['Revit', 'AutoCAD', 'TRACE 700', 'IES-VE', 'Bluebeam', 'Excel'].map((t) => <li>{t}</li>)}
        </ul>
        <a class="btn" href={url('/experience/wsp/')}>See the internship</a>
      </div>
    </div>
    <div class="tiles">
      <a class="reveal" href={url('/experience/wsp/#site-visits')}>
        <Image src={wspSite} alt="" widths={[400, 700]} sizes="(max-width: 700px) 100vw, 33vw" />
        <span>Site visits</span>
      </a>
      <a class="reveal" href={url('/experience/wsp/#hawaii-prince-waikiki-spa-renovation')}>
        <Image src={wspPlan} alt="" widths={[400, 700]} sizes="(max-width: 700px) 100vw, 33vw" />
        <span>Hawaii Prince Waikiki Spa Renovation</span>
      </a>
      <a class="reveal" href={url('/experience/wsp/#excel-calculation-tools')}>
        <Image src={wspExcel} alt="" widths={[400, 700]} sizes="(max-width: 700px) 100vw, 33vw" />
        <span>Excel calculation tools</span>
      </a>
    </div>
  </section>

  <section class="section section-dark punahou-band" aria-labelledby="punahou-title">
    <div class="wrap">
      <div class="band-grid">
        <div class="reveal">
          <h2 id="punahou-title">Punahou School</h2>
          <p class="lead">
            Where I started engineering: a go-kart, a solar charger for a ride-on train, enrichment toys for the Honolulu Zoo,
            and machine shop competency tests.
          </p>
          <a class="btn" href={url('/punahou/')}>See Punahou projects</a>
        </div>
        <div class="band-ta reveal">
          <h3>Robotics Teaching Assistant</h3>
          <p>
            At Punahou School I supported fourth through sixth graders in their robotics journey, helping them both build
            robots and code them.
          </p>
          <a class="text-link" href={url('/experience/robotics-ta/')}>See the role <span class="arrow" aria-hidden="true"></span></a>
        </div>
      </div>
      <div class="tiles">
        {punahou.map((p) => (
          <a class="reveal" href={url(p.href)} style={[p.position && `--pos: ${p.position}`, p.fit && `--fit: ${p.fit}`].filter(Boolean).join('; ') || undefined}>
            <Image src={p.image} alt={p.alt} widths={[400, 700]} sizes="(max-width: 700px) 100vw, 33vw" />
            <span>{p.title}</span>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Full-width hero: photos wipe in one after another under a dark scrim, with white text on top */
  .hero {
    position: relative;
    min-height: clamp(500px, 80vh, 820px); /* short enough that the projects below start to show */
    min-height: clamp(500px, 80svh, 820px); /* phones: measured without the browser's address bar */
    display: flex;
    align-items: flex-end;
    overflow: hidden;
    background: var(--ink);
    color: #fff;
    --focus-ring: var(--accent);
  }
  .slides { position: absolute; inset: 0; z-index: 0; }
  /* Each new photo wipes in from left to right over the last one, with a thin tan edge */
  .slide-frame {
    position: absolute; inset: 0;
    clip-path: inset(0 100% 0 0);
    z-index: 0;
  }
  .slide-frame.is-active { clip-path: inset(0 0 0 0); z-index: 2; }
  .slide-frame.is-entering { z-index: 3; animation: heroWipe 0.8s cubic-bezier(0.7, 0, 0.2, 1) forwards; }
  .slide-frame.is-leaving { clip-path: inset(0 0 0 0); z-index: 1; }
  .slide-frame::after {
    content: ''; position: absolute; top: 0; bottom: 0; right: 0; width: 3px; background: var(--accent);
    opacity: 0; z-index: 2;
  }
  .slide-frame.is-entering::after { opacity: 1; animation: heroEdge 1s linear forwards; }
  @keyframes heroWipe { from { clip-path: inset(0 100% 0 0); } to { clip-path: inset(0 0 0 0); } }
  @keyframes heroEdge { 0%, 85% { opacity: 1; } 100% { opacity: 0; } }
  .slide-frame :global(img) { width: 100%; height: 100%; object-fit: cover; object-position: var(--pos); }

  /* One scrim for every photo: darkest behind the text (left and bottom), so the photo still shows on the right */
  .shade {
    position: absolute; inset: 0; z-index: 4; pointer-events: none;
    background:
      linear-gradient(90deg, rgba(20, 29, 40, 0.88) 0%, rgba(20, 29, 40, 0.66) 42%, rgba(20, 29, 40, 0.18) 100%),
      linear-gradient(0deg, rgba(20, 29, 40, 0.8) 0%, rgba(20, 29, 40, 0) 58%);
  }

  /* Slideshow bar (bottom right): pause button, "03 / 07" and the caption, with a tan line
     underneath that fills while each photo is up. The line's animation sets the pace. */
  .slide-bar {
    position: absolute; right: clamp(16px, 4vw, 48px); bottom: clamp(16px, 3vw, 32px); z-index: 6;
    display: flex; align-items: center; gap: 12px;
    padding: 6px 14px 8px 6px; border-radius: 2px;
    background: rgba(20, 29, 40, 0.72);
    color: #fff;
  }
  .slide-caption { position: relative; margin: 0; display: flex; gap: 10px; font-size: var(--fs-small); font-weight: 600; line-height: 1.3; }
  .slide-count { color: var(--steel-on-dark); font-variant-numeric: tabular-nums; }
  .slide-pause {
    display: grid; place-items: center; width: 32px; height: 32px; padding: 0;
    color: #fff; background: rgba(255, 255, 255, 0.1); border: 0; border-radius: 2px; cursor: pointer;
    transition: background 0.2s var(--ease), transform 0.15s var(--ease);
  }
  .slide-pause[hidden] { display: none; }
  .slide-pause:hover { background: rgba(255, 255, 255, 0.22); }
  .slide-pause:active { transform: scale(0.94); }
  .slide-pause svg { width: 14px; height: 14px; fill: currentColor; }
  .slide-pause .i-play, .hero.is-paused .slide-pause .i-pause { display: none; }
  .hero.is-paused .slide-pause .i-play { display: block; }
  .slide-progress { position: absolute; left: 0; right: 0; bottom: 0; height: 2px; background: var(--accent); transform: scaleX(0); transform-origin: left; }
  .hero.is-playing .slide-progress { animation: slideTimer var(--slide-ms, 6000ms) linear forwards; }
  .hero.is-paused .slide-progress { animation-play-state: paused; }
  @keyframes slideTimer { to { transform: scaleX(1); } }

  .hero-content { position: relative; z-index: 5; padding-block: clamp(80px, 12vw, 140px) clamp(72px, 9vw, 104px); }
  .hero h1 {
    color: #fff;
    font-size: var(--fs-display);
    font-weight: 800;
    letter-spacing: -0.025em;
    margin-bottom: 0.18em;
  }
  .role { margin: 0 0 0.15em; font-size: var(--fs-lead); font-weight: 700; line-height: 1.4; color: #fff; }
  /* Degree and graduation date: the first thing a recruiter checks */
  .school .nowrap { white-space: nowrap; }
  .school { margin: 0 0 1.1em; max-width: 46ch; font-size: var(--fs-lead); font-weight: 500; line-height: 1.4; text-wrap: balance; color: #fff; }
  .focus { font-size: var(--fs-small); font-weight: 600; text-wrap: balance; color: #c9d0d7; margin-bottom: 2em; }
  .hero-btns { display: flex; flex-wrap: wrap; align-items: center; gap: 16px 32px; }
  .hero-btns .text-link { color: #fff; }
  .hero-btns .text-link:hover { color: var(--accent); }
  .hero-btns .btn { min-width: 180px; background: #fff; color: var(--ink); border-color: #fff; }
  .hero-btns .btn:hover { background: var(--accent); border-color: var(--accent); color: var(--ink); }

  /* On load, the text rises in line by line, once */
  @media (prefers-reduced-motion: no-preference) {
    .hero-content > * { animation: heroRise 0.8s cubic-bezier(0.16, 1, 0.3, 1) both; }
    .hero-content > :nth-child(2) { animation-delay: 70ms; }
    .hero-content > :nth-child(3) { animation-delay: 120ms; }
    .hero-content > :nth-child(4) { animation-delay: 170ms; }
    .hero-content > :nth-child(5) { animation-delay: 220ms; }
  }
  @keyframes heroRise { from { opacity: 0; transform: translateY(14px); } }

  /* Phone: the button runs full width, the two links sit side by side under it */
  @media (max-width: 560px) {
    .hero-content { padding-bottom: 84px; }
    .hero-btns { gap: 16px 28px; }
    .hero-btns .btn { flex: 1 0 100%; padding-block: 0.9em; }
    /* the date drops to its own line instead of leaving the dot at the end of a line */
    .school .sep { display: block; height: 0; overflow: hidden; }
    .slide-bar { left: calc(var(--gutter) - 6px); right: auto; } /* the button lines up with the text above */
  }

  /* Reduced motion: the script leaves the first photo up and never switches */
  @media (prefers-reduced-motion: reduce) {
    .slide-frame.is-entering, .slide-frame.is-entering::after { animation: none !important; }
  }

  /* About section: headshot on one side, text on the other */
  .about {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: clamp(32px, 5vw, 64px);
    align-items: center;
    padding-block: clamp(64px, 9vw, 112px);
    overflow-x: clip;
  }
  /* Portrait frame anchored at the top of the photo, so the head keeps its headroom
     and the eyes sit about a third of the way down */
  .about-photo { position: relative; aspect-ratio: 4 / 5; }
  .about-photo :global(img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 50% 0%; border-radius: 4px; }
  .about-text { display: flex; flex-direction: column; }
  .about-text h2 { margin: -0.12em 0 0.45em; line-height: 1; }
  .about-copy { max-width: 62ch; }
  .about-copy p { font-size: var(--fs-body); margin: 0 0 1em; }
  .about-copy p:last-child { margin-bottom: 0; }
  .facts-row { margin: 1.4em 0 0; font-size: var(--fs-small); font-weight: 600; text-wrap: balance; color: var(--steel); }
  .about-cta { margin-top: 28px; }

  @media (max-width: 860px) {
    .about { grid-template-columns: 1fr; padding-top: 56px; }
    .about-photo { max-width: 420px; margin-inline: auto; width: 100%; }
  }

  .section-tight { padding-block: clamp(48px, 7vw, 88px) clamp(56px, 8vw, 96px); background: var(--white); border-block: 1px solid var(--mist); }

  /* Featured projects: three columns, each ending in a Predicted / Measured table.
     The tables sit at the bottom of each column so they line up across the row. */
  .featured-head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 8px 24px; margin-bottom: clamp(24px, 3vw, 40px); }
  .featured-head h2 { margin: 0; }
  .all-link, .text-link { display: inline-flex; align-items: center; gap: 10px; font-weight: 600; font-size: var(--fs-body); }
  .arrow { position: relative; width: 16px; height: 1.5px; background: currentColor; transition: transform 0.2s var(--ease); }
  .arrow::after { content: ''; position: absolute; right: 0; top: -3.5px; width: 7px; height: 7px; border-top: 1.5px solid currentColor; border-right: 1.5px solid currentColor; transform: rotate(45deg); }
  .all-link:hover .arrow, .text-link:hover .arrow { transform: translateX(3px); }

  .featured-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(28px, 3.5vw, 48px); margin: 0; padding: 0; list-style: none; }
  .fcard { position: relative; display: flex; flex-direction: column; }
  .fcard-media { display: block; aspect-ratio: 4 / 3; overflow: hidden; border-radius: var(--radius); background: #e7e6e1; margin-bottom: 18px; }
  .fcard-media :global(img) { width: 100%; height: 100%; object-fit: cover; object-position: var(--pos, 50% 50%); transition: transform 0.6s var(--ease); }
  @media (hover: hover) { .fcard:hover .fcard-media :global(img) { transform: scale(1.03); } }
  .fcard-body { display: flex; flex-direction: column; flex: 1; }
  .fcard h3 { margin: 0 0 4px; font-size: var(--fs-lead); font-weight: 800; text-wrap: balance; }
  .fcard h3 a { color: var(--ink); text-decoration: none; }
  /* The title link covers the whole column, so the photo and table are clickable too */
  .fcard h3 a::after { content: ''; position: absolute; inset: -8px; border-radius: 6px; }
  .fcard:hover h3 a { text-decoration: underline; }
  .fcard h3 a:focus-visible { outline: none; }
  .fcard h3 a:focus-visible::after { outline: 2px solid var(--ink); outline-offset: 2px; }
  .fcard-meta { margin: 0 0 12px; font-size: var(--fs-small); color: var(--charcoal); }
  .fcard-summary { margin: 0 0 22px; font-size: var(--fs-body); }
  .results { margin: auto 0 0; border-top: 1.5px solid var(--ink); }
  .results div { display: flex; align-items: baseline; justify-content: space-between; gap: 16px; padding: 9px 0; border-bottom: 1px solid var(--mist); }
  .results dt { font-size: var(--fs-small); font-weight: 600; color: var(--charcoal); }
  .results dd { margin: 0; text-align: right; font-size: var(--fs-body); font-weight: 500; font-variant-numeric: tabular-nums; color: var(--charcoal); }
  .results div:last-child dd { font-size: var(--fs-lead); font-weight: 800; color: var(--ink); }
  .results-note { margin: 10px 0 0; font-size: var(--fs-small); line-height: 1.5; color: var(--charcoal); }

  /* Desktop: the columns share rows, so titles, tables and notes line up across all three
     even when one summary or note is longer than the others */
  @media (min-width: 961px) {
    .featured-grid { row-gap: 0; }
    .fcard { display: grid; grid-row: span 6; grid-template-rows: subgrid; }
    .fcard-body { display: contents; }
    .results { margin-top: 0; }
  }

  /* Tablet: one project per row, photo beside the text */
  @media (max-width: 960px) {
    .featured-grid { grid-template-columns: 1fr; gap: 44px; }
    .fcard { display: grid; grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr); gap: 28px; align-items: start; }
    .fcard-media { margin: 0; }
  }
  /* Phone: photo on top, a little shorter */
  @media (max-width: 600px) {
    .fcard { display: flex; }
    .fcard-media { aspect-ratio: 16 / 10; margin-bottom: 16px; }
  }

  .browse { margin-top: clamp(36px, 4vw, 52px); padding-top: 24px; border-top: 1px solid var(--mist); }


  /* Photo and text start on the same line; on desktop the photo stays in view while the text is read */
  .wsp-grid { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr); gap: clamp(28px, 4vw, 64px); align-items: start; }
  .wsp-photo { position: sticky; top: calc(var(--header-h) + 24px); display: block; overflow: hidden; border-radius: var(--radius); }
  @media (max-width: 900px) { .wsp-grid { grid-template-columns: 1fr; } .wsp-photo { position: static; } }
  .wsp-photo :global(img) { width: 100%; height: auto; transition: transform 0.8s var(--ease); }
  .wsp-text h2 { margin-top: -0.1em; }
  .wsp-text p { font-size: var(--fs-body); }
  .wsp-text .wsp-meta { margin: -0.2em 0 1em; font-size: var(--fs-small); font-weight: 600; color: var(--charcoal); }
  .wsp-tools { margin: 0.4em 0 28px; }

  /* Rows of three photo links with a label along the bottom (WSP and Punahou) */
  .tiles { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; margin-top: 28px; }
  .tiles a { position: relative; display: block; aspect-ratio: 4 / 3; overflow: hidden; border-radius: 3px; background: #fff; }
  @media (max-width: 700px) { .tiles { grid-template-columns: 1fr; gap: 12px; } .tiles a { aspect-ratio: 16 / 9; } }
  .tiles :global(img) { width: 100%; height: 100%; object-fit: var(--fit, cover); object-position: var(--pos, 50% 50%); transition: transform 0.7s var(--ease); }
  @media (hover: hover) {
    .tiles a:hover :global(img) { transform: scale(1.04); }
    .wsp-photo:hover :global(img) { transform: scale(1.02); }
  }
  .tiles span {
    position: absolute; left: 0; right: 0; bottom: 0; padding: 26px 16px 12px;
    background: linear-gradient(rgba(23, 33, 45, 0), rgba(23, 33, 45, 0.88) 65%); color: #fff;
    font-size: var(--fs-small); font-weight: 600;
  }

  /* Punahou School band: intro and the teaching role side by side, then three projects */
  .band-grid { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr); gap: clamp(32px, 6vw, 96px); align-items: end; }
  @media (max-width: 760px) { .band-grid { grid-template-columns: 1fr; } }
  .punahou-band .lead { color: #c9d0d7; }
  .band-ta { padding-top: 20px; border-top: 1px solid rgba(255, 255, 255, 0.22); }
  .band-ta h3 { margin-bottom: 0.4em; }
  .band-ta p { color: #c9d0d7; font-size: var(--fs-body); }
  .punahou-band .tiles { margin-top: clamp(36px, 5vw, 56px); }
</style>

<script>
  // Hero: show each photo for 6 seconds, then wipe to the next one. The tan line in the
  // slideshow bar fills over those 6 seconds; when it is full, the next photo comes in.
  // The pause button stops the line (and the slideshow) where it is.
  // With "reduce motion" turned on, the first photo stays up, nothing moves and there is no button.
  const SLIDE_MS = 6000;
  const hero = document.querySelector<HTMLElement>('[data-hero]');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (hero && !reduceMotion) {
    const frames = Array.from(hero.querySelectorAll<HTMLElement>('.slide-frame'));
    const progress = hero.querySelector<HTMLElement>('.slide-progress')!;
    const pauseBtn = hero.querySelector<HTMLButtonElement>('.slide-pause')!;
    const countEl = hero.querySelector<HTMLElement>('[data-count]')!;
    const captionEl = hero.querySelector<HTMLElement>('[data-caption-text]')!;
    let current = 0;

    hero.style.setProperty('--slide-ms', `${SLIDE_MS}ms`);
    // Restart the tan line from empty
    const startTimer = () => {
      hero.classList.remove('is-playing');
      void progress.offsetWidth;
      hero.classList.add('is-playing');
    };

    const next = () => {
      const prev = frames[current];
      current = (current + 1) % frames.length;
      const incoming = frames[current];
      prev.classList.remove('is-active');
      prev.classList.add('is-leaving');
      incoming.classList.add('is-entering');
      countEl.textContent = String(current + 1).padStart(2, '0');
      captionEl.textContent = incoming.dataset.caption ?? '';
      // Finish the swap when the wipe ends (with a timer backup in case the browser skips the event)
      let finished = false;
      const finish = () => {
        if (finished) return;
        finished = true;
        incoming.classList.remove('is-entering');
        incoming.classList.add('is-active');
        prev.classList.remove('is-leaving');
      };
      incoming.addEventListener('animationend', (e) => { if (e.target === incoming) finish(); }, { once: true });
      setTimeout(finish, 900);
    };

    progress.addEventListener('animationend', () => {
      if (!document.hidden) next(); // in a background tab, wait another round instead
      startTimer();
    });

    pauseBtn.hidden = false;
    pauseBtn.addEventListener('click', () => {
      const paused = hero.classList.toggle('is-paused');
      pauseBtn.setAttribute('aria-label', paused ? 'Play slideshow' : 'Pause slideshow');
    });
    startTimer();
  }
</script>
