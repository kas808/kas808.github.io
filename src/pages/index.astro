---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectIndex from '../components/ProjectIndex.astro';
import FeaturedCarousel from '../components/FeaturedCarousel.astro';
import { url } from '../lib/url';
import { site } from '../lib/site';
import headshot from '../assets/headshot.jpg';
import sketchA from '../content/projects/toggle-clamp-dfm/01_assembly_drawing_with_BOM.png';
import sketchB from '../content/projects/wind-turbine/03_solidworks_rotor_iso.png';
import sketchC from '../content/projects/toggle-clamp-dfm/02_interface_plate_drawing.png';
import wspTeam from '../content/experience/wsp/00_wsp_team.jpg';
import wspSite from '../content/experience/wsp/ulana_03.jpg';
import wspPlan from '../content/experience/wsp/spa_plan_04.jpg';
import wspExcel from '../content/experience/wsp/building-pressurization-excel-sheet-walk-through.jpg';
---

<BaseLayout>
  <section class="hero wrap">
    <div class="hero-photo reveal">
      <Image src={headshot} alt="Portrait of Kasin Ito-Sato" widths={[360, 560, 800]} sizes="(max-width: 860px) 80vw, 40vw" loading="eager" fetchpriority="high" />
    </div>
    <div class="hero-text reveal">
      <div class="sketches" aria-hidden="true">
        <Image class="sk sk-a" src={sketchA} alt="" width={420} />
        <Image class="sk sk-b" src={sketchB} alt="" width={300} />
        <Image class="sk sk-c" src={sketchC} alt="" width={320} />
      </div>
      <h1>I'm Kasin Ito-Sato, a Mechanical Engineer.</h1>
      <p class="focus">Mechanical Design · Testing & Analysis · HVAC/MEP · GD&T</p>
      <p class="lead">
        I'm a mechanical engineering student at Loyola Marymount University (BS, May 2027). I've designed and machined
        precision linkages, built my team's HVAC calculation tools as an intern at WSP, and I'm now working across aero,
        structures, propulsion and controls on our SAE Aero Design capstone.
      </p>
      <div class="hero-btns">
        <a class="btn" href={site.linkedin} target="_blank" rel="noopener">LinkedIn</a>
        <a class="btn" href={url('/projects/')}>Projects</a>
        <a class="btn" href={url('/resume/')}>Resume</a>
      </div>
    </div>
  </section>

  <section class="showcase section-tight" aria-labelledby="featured-title">
    <div class="wrap">
      <h2 id="featured-title" class="center">Featured Projects.</h2>
    </div>
    <FeaturedCarousel />
    <div class="wrap all-projects">
      <button class="btn all-btn" aria-expanded="false" aria-controls="all-projects-panel">
        View all projects <span class="caret" aria-hidden="true"></span>
      </button>
      <div id="all-projects-panel" class="all-panel" hidden>
        <ProjectIndex />
      </div>
    </div>
  </section>

  <section class="section wrap wsp" aria-labelledby="wsp-title">
    <div class="wsp-grid">
      <a class="wsp-photo reveal" href={url('/experience/wsp/')} tabindex="-1">
        <Image src={wspTeam} alt="Kasin with the WSP Honolulu intern class and a mentor in the office" widths={[600, 900, 1300]} sizes="(max-width: 900px) 100vw, 55vw" />
      </a>
      <div class="wsp-text reveal">
        <p class="eyebrow">Internship · Honolulu, HI · May 2025 to January 2026</p>
        <h2 id="wsp-title">WSP | Mechanical Engineering Intern.</h2>
        <p>
          During my internship at WSP, I worked with licensed mechanical engineers to design HVAC, plumbing, and fire
          protection systems for commercial and residential projects. I performed load calculations and drafting, and
          researched ASHRAE 62.1 and 90.1 standards, IECC codes, and industry practices to apply them to real project
          conditions. I gained experience using Revit, AutoCAD, TRACE 700, IES-VE, and Bluebeam to develop, revise, and
          coordinate mechanical system drawings, BIM documentation, and project submittals. I also created custom Excel
          sheets that looked at demand-controlled ventilation, building pressurization, and exhaust airflow requirements.
        </p>
        <a class="btn" href={url('/experience/wsp/')}>See the internship</a>
      </div>
    </div>
    <div class="wsp-strip">
      <a class="reveal" href={url('/experience/wsp/#site-visits')}>
        <Image src={wspSite} alt="" widths={[400, 700]} sizes="(max-width: 700px) 100vw, 33vw" />
        <span>Site visits</span>
      </a>
      <a class="reveal" href={url('/experience/wsp/#hawaii-prince-spa-mechanical-plans')}>
        <Image src={wspPlan} alt="" widths={[400, 700]} sizes="(max-width: 700px) 100vw, 33vw" />
        <span>Hawaii Prince Spa mechanical plans</span>
      </a>
      <a class="reveal" href={url('/experience/wsp/#excel-calculation-tools')}>
        <Image src={wspExcel} alt="" widths={[400, 700]} sizes="(max-width: 700px) 100vw, 33vw" />
        <span>Excel calculation tools</span>
      </a>
    </div>
  </section>

  <section class="section section-dark">
    <div class="wrap split">
      <div class="reveal">
        <p class="eyebrow">Experience</p>
        <h2>Robotics Teaching Assistant.</h2>
        <p class="lead">
          At Punahou School I supported fourth through sixth graders in their robotics journey, helping them both build
          robots and code them.
        </p>
        <a class="btn" href={url('/experience/robotics-ta/')}>See the role</a>
      </div>
      <div class="reveal">
        <p class="eyebrow">Before LMU</p>
        <h2>Punahou School.</h2>
        <p class="lead">
          Where I started engineering: a go-kart, a solar charger for a ride-on train, enrichment toys for the Honolulu Zoo,
          and machine shop competency tests.
        </p>
        <a class="btn" href={url('/punahou/')}>See Punahou projects</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: clamp(32px, 6vw, 88px);
    align-items: center;
    padding-block: clamp(40px, 8vw, 110px);
    overflow-x: clip;
  }
  .hero-photo :global(img) { width: 100%; aspect-ratio: 4 / 5; object-fit: cover; object-position: 50% 0%; border-radius: 4px; }
  .hero-text { position: relative; text-align: center; padding: 24px 0; }
  .hero-text h1 { position: relative; font-size: clamp(2.2rem, 5vw, 3.9rem); margin-bottom: 0.5em; }
  .hero-text .lead { position: relative; margin-inline: auto; max-width: 46ch; font-size: 1.02rem; }
  .hero-btns { position: relative; display: flex; flex-direction: column; align-items: center; gap: 12px; margin-top: 28px; }
  .hero-btns .btn { min-width: 220px; }

  .sketches { position: absolute; inset: -40px -60px; pointer-events: none; }
  .sk { position: absolute; height: auto; mix-blend-mode: multiply; filter: grayscale(1) contrast(1.2); opacity: 0.13; }
  .sk-a { width: 300px; top: -30px; right: -40px; }
  .sk-b { width: 190px; bottom: -10px; right: -20px; }
  .sk-c { width: 210px; bottom: 10px; left: -40px; }
  @media (max-width: 1100px) { .sketches { inset: -20px -10px; } .sk-a { width: 220px; } }

  @media (max-width: 860px) {
    .hero { grid-template-columns: 1fr; }
    .hero-photo { max-width: 420px; margin-inline: auto; width: 100%; }
    .sketches { display: none; }
  }

  .focus { position: relative; font-size: 0.72rem; font-weight: 600; letter-spacing: 0.08em; text-wrap: balance; text-transform: uppercase; color: var(--steel); margin-bottom: 1.4em; }

  .section-tight { padding-block: clamp(40px, 6vw, 72px) clamp(56px, 8vw, 96px); background: var(--white); border-block: 1px solid var(--mist); }
  .showcase h2 { margin-bottom: clamp(24px, 3vw, 36px); }

  .all-projects { margin-top: 36px; display: flex; flex-direction: column; align-items: center; }
  .all-btn { font-size: 0.9rem; padding: 1em 2.6em; min-width: 280px; border-radius: 16px 0 16px 0; box-shadow: 0 10px 24px -14px rgba(37, 52, 71, 0.7); }
  .all-btn .caret { width: 8px; height: 8px; border-right: 1.5px solid currentColor; border-bottom: 1.5px solid currentColor; transform: translateY(-2px) rotate(45deg); transition: transform 0.2s var(--ease); }
  .all-btn[aria-expanded='true'] .caret { transform: translateY(1px) rotate(-135deg); }
  .all-panel { width: 100%; margin-top: 24px; padding: 28px; background: var(--paper); border: 1px solid var(--mist); border-radius: var(--radius); animation: drop 0.25s var(--ease); }
  @keyframes drop { from { opacity: 0; transform: translateY(-6px); } to { opacity: 1; transform: none; } }

  .wsp-grid { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr); gap: clamp(28px, 4vw, 64px); align-items: center; }
  @media (max-width: 900px) { .wsp-grid { grid-template-columns: 1fr; } }
  .wsp-photo { display: block; overflow: hidden; border-radius: 3px; box-shadow: 0 24px 48px -30px rgba(37, 52, 71, 0.55); }
  .wsp-photo :global(img) { width: 100%; height: auto; transition: transform 0.8s var(--ease); }
  .wsp-photo:hover :global(img) { transform: scale(1.02); }
  .wsp-text h2 { font-size: clamp(1.7rem, 3vw, 2.4rem); }
  .wsp-text p:not(.eyebrow) { font-size: 0.98rem; }
  .wsp-strip { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; margin-top: 28px; }
  @media (max-width: 700px) { .wsp-strip { grid-template-columns: 1fr; } }
  .wsp-strip a { position: relative; display: block; aspect-ratio: 4 / 3; overflow: hidden; border-radius: 3px; background: #fff; }
  .wsp-strip :global(img) { width: 100%; height: 100%; object-fit: cover; transition: transform 0.7s var(--ease); }
  .wsp-strip a:hover :global(img) { transform: scale(1.04); }
  .wsp-strip span {
    position: absolute; left: 0; right: 0; bottom: 0; padding: 26px 16px 12px;
    background: linear-gradient(transparent, rgba(23, 33, 45, 0.82)); color: #fff;
    font-size: 0.78rem; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase;
  }

  .split { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(40px, 6vw, 96px); }
  .split .lead { color: #c9d0d7; }
  @media (max-width: 760px) { .split { grid-template-columns: 1fr; } }
</style>

<script>
  const allBtn = document.querySelector<HTMLButtonElement>('.all-btn');
  const panel = document.getElementById('all-projects-panel');
  allBtn?.addEventListener('click', () => {
    const open = allBtn.getAttribute('aria-expanded') !== 'true';
    allBtn.setAttribute('aria-expanded', String(open));
    if (panel) panel.hidden = !open;
  });
</script>
