---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import AllProjectsButton from '../components/AllProjectsButton.astro';
import FeaturedCarousel from '../components/FeaturedCarousel.astro';
import { url } from '../lib/url';
import { site } from '../lib/site';
import headshot from '../assets/headshot.jpg';
// Faint line drawings from my own AutoCAD and SolidWorks work (made transparent for the background)
import sketchA from '../assets/sketches/wrench.png';
import sketchB from '../assets/sketches/bracket.png';
import sketchC from '../assets/sketches/support.png';
// Hero photos, shown in this order with a quick wipe between them
import heroLanakila from '../assets/featured/lanakila-express.jpg';
import heroWsp from '../assets/hero/wsp-site-visit.jpg';
import heroPantograph from '../assets/hero/pantograph.jpg';
import heroShop from '../assets/hero/shop.jpg';
import heroRope from '../content/projects/rope-climbing-robot/02_robot_on_rope.jpg';
import heroSloth from '../assets/hero/sloth.jpg';
import heroKart from '../assets/hero/go-kart.jpg';
import wspTeam from '../content/experience/wsp/00_wsp_team.jpg';
import wspSite from '../content/experience/wsp/ulana_03.jpg';
import wspPlan from '../content/experience/wsp/spa_plan_04.jpg';
import wspExcel from '../content/experience/wsp/building-pressurization-excel-sheet-walk-through.jpg';

const heroSlides = [
  { src: heroLanakila, caption: 'Lanakila Express, Punahou School', position: '50% 60%' },
  { src: heroWsp, caption: 'WSP site visit', position: '50% 45%' },
  { src: heroPantograph, caption: '2x Magnifying Pantograph', position: '50% 55%' },
  { src: heroShop, caption: 'In the shop', position: '50% 40%' },
  { src: heroRope, caption: 'Rope Climbing Robot', position: '50% 40%' },
  { src: heroSloth, caption: 'Waikiki Zootopia sloth toy at the Honolulu Zoo', position: '50% 48%' },
  { src: heroKart, caption: 'Go-Kart, Punahou School', position: '50% 50%' },
];
---

<BaseLayout>
  <section class="hero" aria-label="Introduction">
    <div class="slides" aria-hidden="true" data-hero>
      {heroSlides.map((h, i) => (
        <div class:list={['slide-frame', i === 0 && 'is-active']} style={`--pos: ${h.position}`}>
          <Image src={h.src} alt="" widths={[900, 1400, 2000, 2400]} sizes="100vw" loading={i === 0 ? 'eager' : 'lazy'} fetchpriority={i === 0 ? 'high' : 'auto'} />
          <span class="slide-caption">{h.caption}</span>
        </div>
      ))}
    </div>
    <div class="shade" aria-hidden="true"></div>
    <div class="wrap hero-content">
      <h1>Kasin Ito-Sato</h1>
      <p class="role">MECHANICAL ENGINEER</p>
      <p class="focus">MECHANICAL DESIGN · THERMAL & FLOW ANALYSIS · ASSEMBLY & TEST · GD&T</p>
      <div class="hero-btns">
        <a class="btn" href={site.linkedin} target="_blank" rel="noopener">LinkedIn</a>
        <a class="btn" href={url('/projects/')}>Projects</a>
        <a class="btn" href={url('/resume/')}>Resume</a>
      </div>
    </div>
  </section>

  <section class="about wrap" aria-labelledby="about-title">
    <div class="about-photo reveal">
      <Image src={headshot} alt="Portrait of Kasin Ito-Sato" widths={[360, 560, 800]} sizes="(max-width: 860px) 80vw, 40vw" />
    </div>
    <div class="about-text reveal">
      <div class="sketches" aria-hidden="true">
        <Image class="sk sk-a" src={sketchA} alt="" width={520} />
        <Image class="sk sk-b" src={sketchB} alt="" width={460} />
        <Image class="sk sk-c" src={sketchC} alt="" width={300} />
      </div>
      <h2 id="about-title">About</h2>
      <div class="about-copy">
        <p>
          I grew up on Oahu and went to Punahou School, where I spent most of my free time in the engineering shop. That's
          where I learned to machine, weld, and wire, building things like a go-kart and a solar charger. For my senior
          capstone, I designed an automated sand and trash filter. I also helped teach younger students as a junior robotics TA.
        </p>
        <p>
          Currently I'm a fourth-year mechanical engineering student at Loyola Marymount University, graduating in May 2027.
          At LMU, I've designed and machined a 2.0x pantograph accurate to within 1%, built a rope-climbing robot, and run
          heat transfer and flow experiments in the lab. Right now I'm on our team for the 2027 SAE Aero Design Regular Class
          competition.
        </p>
        <p>
          At WSP, I interned in HVAC and plumbing design for commercial and residential projects. I sized equipment from load
          calculations in IES-VE and TRACE 700, revised layouts in Revit and AutoCAD, worked with architects and manufacturers,
          and built three Excel analysis tools my team adopted.
        </p>
        <p>
          What I enjoy most is figuring out why a system behaves the way it does, then building it, testing it, and adjusting
          until it works. I'm looking for a full-time role where I can keep doing that.
        </p>
      </div>
      <p class="facts-row">LOS ANGELES, CA · FE MECHANICAL EXAM NOV 2026 · ENGLISH & JAPANESE</p>
    </div>
  </section>

  <section class="showcase section-tight" aria-labelledby="featured-title">
    <div class="wrap">
      <h2 id="featured-title" class="center">Featured Projects</h2>
    </div>
    <FeaturedCarousel />
    <AllProjectsButton hidePlaceholders />
  </section>

  <section class="section wrap wsp" aria-labelledby="wsp-title">
    <div class="wsp-grid">
      <a class="wsp-photo reveal" href={url('/experience/wsp/')} tabindex="-1">
        <Image src={wspTeam} alt="Kasin with the WSP Honolulu intern class and a mentor in the office" widths={[600, 900, 1300]} sizes="(max-width: 900px) 100vw, 55vw" />
      </a>
      <div class="wsp-text reveal">
        <p class="eyebrow">Internship · Honolulu, HI · May 2025 to January 2026</p>
        <h2 id="wsp-title">WSP | Mechanical Engineering Intern</h2>
        <p>
          During my internship at WSP, I worked with licensed mechanical engineers to design HVAC, plumbing, and fire
          protection systems for commercial and residential projects. I performed load calculations and drafting, and
          researched ASHRAE 62.1 and 90.1 standards, IECC codes, and industry practices to apply them to real project
          conditions. I gained experience using Revit, AutoCAD, TRACE 700, IES-VE, and Bluebeam to develop, revise, and
          coordinate mechanical system drawings, BIM documentation, and project submittals. I also created custom Excel
          sheets that looked at demand-controlled ventilation, building pressurization, and exhaust airflow requirements.
        </p>
        <a class="btn" href={url('/experience/wsp/')}>See the internship</a>
      </div>
    </div>
    <div class="wsp-strip">
      <a class="reveal" href={url('/experience/wsp/#site-visits')}>
        <Image src={wspSite} alt="" widths={[400, 700]} sizes="(max-width: 700px) 100vw, 33vw" />
        <span>Site visits</span>
      </a>
      <a class="reveal" href={url('/experience/wsp/#hawaii-prince-waikiki-spa-renovation')}>
        <Image src={wspPlan} alt="" widths={[400, 700]} sizes="(max-width: 700px) 100vw, 33vw" />
        <span>Hawaii Prince Waikiki Spa Renovation</span>
      </a>
      <a class="reveal" href={url('/experience/wsp/#excel-calculation-tools')}>
        <Image src={wspExcel} alt="" widths={[400, 700]} sizes="(max-width: 700px) 100vw, 33vw" />
        <span>Excel calculation tools</span>
      </a>
    </div>
    <div class="to-top">
      <a class="btn btn-ghost" href="#main" data-top>Back to top <span class="up" aria-hidden="true"></span></a>
    </div>
  </section>

  <section class="section section-dark">
    <div class="wrap split">
      <div class="reveal">
        <p class="eyebrow">Experience</p>
        <h2>Robotics Teaching Assistant</h2>
        <p class="lead">
          At Punahou School I supported fourth through sixth graders in their robotics journey, helping them both build
          robots and code them.
        </p>
        <a class="btn" href={url('/experience/robotics-ta/')}>See the role</a>
      </div>
      <div class="reveal">
        <p class="eyebrow">Before LMU</p>
        <h2>Punahou School</h2>
        <p class="lead">
          Where I started engineering: a go-kart, a solar charger for a ride-on train, enrichment toys for the Honolulu Zoo,
          and machine shop competency tests.
        </p>
        <a class="btn" href={url('/punahou/')}>See Punahou projects</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Full-width hero: photos crossfade with a slow zoom under a dark gradient */
  .hero {
    position: relative;
    min-height: clamp(520px, 88vh, 860px);
    display: flex;
    align-items: flex-end;
    overflow: hidden;
    background: var(--ink);
    color: #fff;
  }
  .slides { position: absolute; inset: 0; }
  /* Each new photo wipes in from left to right over the last one, with a thin tan edge */
  .slide-frame {
    position: absolute; inset: 0;
    clip-path: inset(0 100% 0 0);
    z-index: 0;
  }
  .slide-frame.is-active { clip-path: inset(0 0 0 0); z-index: 2; }
  .slide-frame.is-entering { z-index: 3; animation: heroWipe 0.9s cubic-bezier(0.7, 0, 0.2, 1) forwards; }
  .slide-frame.is-leaving { clip-path: inset(0 0 0 0); z-index: 1; }
  .slide-frame::after {
    content: ''; position: absolute; top: 0; bottom: 0; right: 0; width: 3px; background: var(--accent);
    opacity: 0; z-index: 2;
  }
  .slide-frame.is-entering::after { opacity: 1; animation: heroEdge 0.9s linear forwards; }
  @keyframes heroWipe { from { clip-path: inset(0 100% 0 0); } to { clip-path: inset(0 0 0 0); } }
  @keyframes heroEdge { 0%, 85% { opacity: 1; } 100% { opacity: 0; } }
  .slide-frame :global(img) { width: 100%; height: 100%; object-fit: cover; object-position: var(--pos); }
  .slide-caption {
    position: absolute; right: clamp(16px, 4vw, 48px); bottom: clamp(16px, 3vw, 32px); z-index: 2;
    font-size: 0.68rem; font-weight: 600; letter-spacing: 0.16em; text-transform: uppercase; color: rgba(255, 255, 255, 0.75);
  }
  .shade {
    position: absolute; inset: 0;
    background:
      linear-gradient(90deg, rgba(20, 29, 40, 0.9) 0%, rgba(20, 29, 40, 0.68) 45%, rgba(20, 29, 40, 0.25) 100%),
      linear-gradient(0deg, rgba(20, 29, 40, 0.75) 0%, rgba(20, 29, 40, 0) 55%);
  }
  .hero-content { position: relative; z-index: 3; padding-block: clamp(80px, 12vw, 140px) clamp(56px, 8vw, 96px); }
  .hero h1 {
    color: #fff;
    font-size: clamp(2.8rem, 7vw, 5.4rem);
    font-weight: 800;
    letter-spacing: 0.005em;
    margin-bottom: 0.2em;
    text-shadow: 0 2px 24px rgba(0, 0, 0, 0.25);
  }
  .role { margin: 0 0 1em; font-size: clamp(0.85rem, 1.4vw, 1rem); font-weight: 600; letter-spacing: 0.24em; color: #fff; }
  .focus { font-size: 0.74rem; font-weight: 600; letter-spacing: 0.1em; text-wrap: balance; text-transform: uppercase; color: #c9d0d7; margin-bottom: 2em; }
  .hero-btns { display: flex; flex-wrap: wrap; gap: 12px; }
  .hero-btns .btn { min-width: 180px; background: #fff; color: var(--ink); border-color: #fff; }
  .hero-btns .btn:hover { background: var(--accent); border-color: var(--accent); color: var(--ink); }

  /* Reduced motion: the script leaves the first photo up and never switches */
  @media (prefers-reduced-motion: reduce) {
    .slide-frame.is-entering, .slide-frame.is-entering::after { animation: none !important; }
  }

  /* About section: headshot on one side, text on the other */
  .about {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: clamp(32px, 6vw, 88px);
    align-items: start;
    padding-block: clamp(72px, 10vw, 130px);
    overflow-x: clip;
  }
  .about-photo :global(img) { width: 100%; aspect-ratio: 4 / 5; object-fit: cover; object-position: 50% 0%; border-radius: 4px; }
  .about-text { position: relative; padding: 24px 0; }
  .about-text h2 { position: relative; z-index: 1; font-size: clamp(2rem, 4vw, 3rem); }
  .about-copy { position: relative; z-index: 1; max-width: 62ch; text-align: left; }
  .about-copy p { font-size: 1.02rem; margin: 0 0 1em; }
  .facts-row { position: relative; z-index: 1; margin: 1.6em 0 0; font-size: 0.74rem; font-weight: 600; letter-spacing: 0.1em; text-wrap: balance; text-transform: uppercase; color: var(--steel); }

  /* Faint line drawings, kept out at the edges and never behind the heading */
  .sketches { position: absolute; inset: 0; pointer-events: none; }
  .sk { position: absolute; height: auto; opacity: 0.12; }
  .sk-a { width: 250px; bottom: calc(100% + 4px); right: -70px; }
  .sk-b { width: 210px; top: calc(100% + 4px); right: -40px; }
  .sk-c { width: 120px; top: 30%; right: -150px; }
  @media (max-width: 1240px) { .sk-c { display: none; } .sk-a { right: -20px; } .sk-b { right: -10px; width: 170px; } }

  @media (max-width: 860px) {
    .about { grid-template-columns: 1fr; padding-top: 56px; }
    .about-photo { max-width: 420px; margin-inline: auto; width: 100%; }
    .sketches { display: none; }
  }

  .section-tight { padding-block: clamp(40px, 6vw, 72px) clamp(56px, 8vw, 96px); background: var(--white); border-block: 1px solid var(--mist); }
  .showcase h2 { margin-bottom: clamp(24px, 3vw, 36px); }


  .wsp-grid { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr); gap: clamp(28px, 4vw, 64px); align-items: center; }
  @media (max-width: 900px) { .wsp-grid { grid-template-columns: 1fr; } }
  .wsp-photo { display: block; overflow: hidden; border-radius: 3px; box-shadow: 0 24px 48px -30px rgba(37, 52, 71, 0.55); }
  .wsp-photo :global(img) { width: 100%; height: auto; transition: transform 0.8s var(--ease); }
  .wsp-photo:hover :global(img) { transform: scale(1.02); }
  .wsp-text h2 { font-size: clamp(1.7rem, 3vw, 2.4rem); }
  .wsp-text p:not(.eyebrow) { font-size: 0.98rem; }
  .wsp-strip { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; margin-top: 28px; }
  @media (max-width: 700px) { .wsp-strip { grid-template-columns: 1fr; } }
  .wsp-strip a { position: relative; display: block; aspect-ratio: 4 / 3; overflow: hidden; border-radius: 3px; background: #fff; }
  .wsp-strip :global(img) { width: 100%; height: 100%; object-fit: cover; transition: transform 0.7s var(--ease); }
  .wsp-strip a:hover :global(img) { transform: scale(1.04); }
  .wsp-strip span {
    position: absolute; left: 0; right: 0; bottom: 0; padding: 26px 16px 12px;
    background: linear-gradient(transparent, rgba(23, 33, 45, 0.82)); color: #fff;
    font-size: 0.78rem; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase;
  }

  .to-top { display: flex; justify-content: center; margin-top: clamp(40px, 5vw, 64px); }
  .to-top .btn { gap: 10px; }
  .up { width: 8px; height: 8px; border-left: 1.5px solid currentColor; border-top: 1.5px solid currentColor; transform: translateY(2px) rotate(45deg); }

  .split { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(40px, 6vw, 96px); }
  .split .lead { color: #c9d0d7; }
  @media (max-width: 760px) { .split { grid-template-columns: 1fr; } }
</style>

<script>
  // Hero: show each photo for about 4.5 seconds, then wipe to the next one.
  // With "reduce motion" turned on, the first photo stays up and nothing moves.
  const hero = document.querySelector<HTMLElement>('[data-hero]');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (hero && !reduceMotion) {
    const frames = Array.from(hero.querySelectorAll<HTMLElement>('.slide-frame'));
    let current = 0;
    const next = () => {
      if (document.hidden) return; // don't run while the tab is in the background
      const prev = frames[current];
      current = (current + 1) % frames.length;
      const incoming = frames[current];
      prev.classList.remove('is-active');
      prev.classList.add('is-leaving');
      incoming.classList.add('is-entering');
      // Finish the swap when the wipe ends (with a timer backup in case the browser skips the event)
      let finished = false;
      const finish = () => {
        if (finished) return;
        finished = true;
        incoming.classList.remove('is-entering');
        incoming.classList.add('is-active');
        prev.classList.remove('is-leaving');
      };
      incoming.addEventListener('animationend', (e) => { if (e.target === incoming) finish(); }, { once: true });
      setTimeout(finish, 1000);
    };
    setInterval(next, 5400);
  }

  // Back to top: scroll smoothly (or jump, for people who prefer reduced motion)
  document.querySelector('[data-top]')?.addEventListener('click', (e) => {
    e.preventDefault();
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    window.scrollTo({ top: 0, behavior: reduce ? 'auto' : 'smooth' });
  });
</script>
