---
import { Image } from 'astro:assets';
import { getEntry } from 'astro:content';
import sharp from 'sharp';
import BaseLayout from '../layouts/BaseLayout.astro';
import SkillChips from '../components/SkillChips.astro';
import { url } from '../lib/url';
import { site } from '../lib/site';
import { featured, punahou } from '../lib/featured';
import headshot from '../assets/headshot.jpg';
// Faint line drawings from my own AutoCAD and SolidWorks work (made transparent for the background)
import sketchA from '../assets/sketches/wrench.png';
import sketchB from '../assets/sketches/bracket.png';
import sketchC from '../assets/sketches/support.png';
// Hero photos, shown in this order with a quick wipe between them
import heroLanakila from '../assets/hero/lanakila-express.jpg';
import heroWsp from '../assets/hero/wsp-site-visit.jpg';
import heroPantograph from '../assets/hero/pantograph.jpg';
import heroShop from '../assets/hero/shop.jpg';
import heroRope from '../content/projects/rope-climbing-robot/02_robot_on_rope.jpg';
import heroRube from '../assets/hero/rube-goldberg.jpg';
import heroKart from '../assets/hero/go-kart.jpg';
import wspTeam from '../content/experience/wsp/00_wsp_team.jpg';
import wspSite from '../content/experience/wsp/ulana_03.jpg';
import wspPlan from '../content/experience/wsp/spa_plan_04.jpg';
import wspExcel from '../content/experience/wsp/building-pressurization-excel-sheet-walk-through.jpg';

// Each slide also records the photo file, so the site can measure how bright it is
// behind the text when it builds. Light photos get navy text, darker ones white text.
const heroFiles = {
  lanakila: 'src/assets/hero/lanakila-express.jpg',
  wsp: 'src/assets/hero/wsp-site-visit.jpg',
  pantograph: 'src/assets/hero/pantograph.jpg',
  shop: 'src/assets/hero/shop.jpg',
  rope: 'src/content/projects/rope-climbing-robot/02_robot_on_rope.jpg',
  rube: 'src/assets/hero/rube-goldberg.jpg',
  kart: 'src/assets/hero/go-kart.jpg',
};
// LMU and WSP work first; Punahou photos come last
const heroSlides = [
  { src: heroWsp, file: heroFiles.wsp, caption: 'WSP site visit', position: '50% 45%' },
  { src: heroPantograph, file: heroFiles.pantograph, caption: '2x Magnifying Pantograph', position: '50% 55%' },
  { src: heroRope, file: heroFiles.rope, caption: 'Rope Climbing Robot', position: '50% 40%' },
  { src: heroShop, file: heroFiles.shop, caption: 'In the shop', position: '50% 45%' },
  { src: heroRube, file: heroFiles.rube, caption: 'Rube Goldberg Machine', position: '50% 45%' },
  { src: heroLanakila, file: heroFiles.lanakila, caption: 'Lanakila Express, Punahou School', position: '50% 62%' },
  { src: heroKart, file: heroFiles.kart, caption: 'Go-Kart, Punahou School', position: '50% 50%' },
];

// Featured projects: title, summary, course, date and photo from each project's index.md,
// plus the measured result from src/lib/featured.ts
const featuredCards = await Promise.all(
  featured.map(async (f) => {
    const entry = await getEntry('projects', f.slug);
    if (!entry) throw new Error(`Featured project "${f.slug}" not found in src/content/projects/`);
    return { ...f, ...entry.data, href: `/projects/${f.slug}/` };
  }),
);

// Brightness (0 = black, 1 = white) of the area behind the text: the left 60%, middle to lower part.
// Above LIGHT_PHOTO, the slide uses navy text; otherwise white text.
const LIGHT_PHOTO = 0.52;
const tones = await Promise.all(
  heroSlides.map(async (h) => {
    const img = sharp(h.file);
    const { width = 1, height = 1 } = await img.metadata();
    const viewH = Math.min(height, Math.round(width * 0.55));
    const top = Math.round((height - viewH) / 2);
    const stats = await sharp(h.file)
      .extract({ left: 0, top: top + Math.round(viewH * 0.3), width: Math.round(width * 0.6), height: Math.round(viewH * 0.55) })
      .greyscale()
      .stats();
    return stats.channels[0].mean / 255 > LIGHT_PHOTO ? 'light' : 'dark';
  }),
);
---

<BaseLayout>
  <section class="hero" aria-label="Introduction" data-tone={tones[0]}>
    <div class="slides" aria-hidden="true" data-hero>
      {heroSlides.map((h, i) => (
        <div class:list={['slide-frame', i === 0 && 'is-active']} style={`--pos: ${h.position}`} data-tone={tones[i]}>
          <Image src={h.src} alt="" widths={[900, 1400, 2000, 2400]} sizes="100vw" loading={i === 0 ? 'eager' : 'lazy'} fetchpriority={i === 0 ? 'high' : 'auto'} />
          <span class="slide-caption">{h.caption}</span>
        </div>
      ))}
    </div>
    <div class="shade shade-dark" aria-hidden="true"></div>
    <div class="shade shade-light" aria-hidden="true"></div>
    <div class="wrap hero-content">
      <h1>Kasin Ito-Sato</h1>
      <p class="role">MECHANICAL ENGINEER</p>
      <p class="school">BS Mechanical Engineering, <span class="nowrap">Loyola Marymount University</span> · May&nbsp;2027</p>
      <p class="focus">MECHANICAL DESIGN · THERMAL & FLOW ANALYSIS · ASSEMBLY & TEST · GD&T</p>
      <div class="hero-btns">
        <a class="btn" href={url('/projects/')}>Projects</a>
        <a class="btn" href={url('/resume/')}>Resume</a>
        <a class="btn btn-line" href={site.linkedin} target="_blank" rel="noopener">LinkedIn</a>
      </div>
    </div>
  </section>

  <section class="about wrap" aria-labelledby="about-title">
    <div class="about-photo reveal">
      <!-- Larger sizes and higher quality than other photos, so the headshot stays sharp on high-resolution screens -->
      <Image src={headshot} alt="Portrait of Kasin Ito-Sato" widths={[480, 720, 1000, 1337]} sizes="(max-width: 860px) 80vw, 40vw" quality={92} />
    </div>
    <div class="about-text reveal">
      <div class="sketches" aria-hidden="true">
        <Image class="sk sk-a" src={sketchA} alt="" width={520} />
        <Image class="sk sk-b" src={sketchB} alt="" width={460} />
        <Image class="sk sk-c" src={sketchC} alt="" width={300} />
      </div>
      <h2 id="about-title">About</h2>
      <div class="about-copy">
        <p>
          I'm a fourth-year mechanical engineering student at Loyola Marymount University, graduating in May 2027, and I'm on
          our team for the 2027 SAE Aero Design Regular Class competition. I grew up on Oahu, where I spent most of my free
          time in the Punahou School engineering shop learning to machine, weld, and wire.
        </p>
        <p>
          What I enjoy most is figuring out why a system behaves the way it does, then building it, testing it, and adjusting
          until it works. After I graduate, I'm looking for a full-time role where I can keep doing that.
        </p>
      </div>
      <p class="facts-row">LOS ANGELES, CA · FE MECHANICAL EXAM NOV 2026 · ENGLISH & JAPANESE</p>
      <div class="btn-row about-cta">
        <a class="btn" href={url('/resume/')}>Resume</a>
        <a class="btn btn-ghost" href={`mailto:${site.email}`}>Email me</a>
      </div>
    </div>
  </section>

  <section class="featured section-tight" aria-labelledby="featured-title">
    <div class="wrap">
      <div class="featured-head">
        <h2 id="featured-title">Featured Projects</h2>
        <a class="all-link" href={url('/projects/')}>All projects <span class="arrow" aria-hidden="true"></span></a>
      </div>
      <ul class="featured-grid">
        {featuredCards.map((f) => (
          <li class="fcard reveal">
            <a class="fcard-media" href={url(f.href)} tabindex="-1" aria-hidden="true" style={f.coverPosition && `--pos: ${f.coverPosition}`}>
              {f.cover && <Image src={f.cover} alt={f.coverAlt ?? ''} widths={[400, 700, 1000]} sizes="(max-width: 600px) 100vw, (max-width: 960px) 40vw, 33vw" />}
            </a>
            <div class="fcard-body">
              <h3><a href={url(f.href)}>{f.title}</a></h3>
              <p class="fcard-meta">{[f.course, f.date].filter(Boolean).join(' · ')}</p>
              <p class="fcard-summary">{f.summary}</p>
              <dl class="results">
                {f.results.map((r) => (
                  <div>
                    <dt>{r.label}</dt>
                    <dd>{r.value}</dd>
                  </div>
                ))}
              </dl>
              <p class="results-note">{f.note}</p>
            </div>
          </li>
        ))}
      </ul>
      <div class="browse"><SkillChips label="Browse by skill" /></div>
    </div>
  </section>

  <section class="section wrap wsp" aria-labelledby="wsp-title">
    <div class="wsp-grid">
      <a class="wsp-photo reveal" href={url('/experience/wsp/')} tabindex="-1">
        <Image src={wspTeam} alt="Kasin with the WSP Honolulu intern class and a mentor in the office" widths={[600, 900, 1300]} sizes="(max-width: 900px) 100vw, 55vw" />
      </a>
      <div class="wsp-text reveal">
        <h2 id="wsp-title">Mechanical Engineering Intern at WSP</h2>
        <p class="wsp-meta">Internship · Honolulu, HI · May 2025 to January 2026</p>
        <p>
          During my internship at WSP, I worked with licensed mechanical engineers to design HVAC, plumbing, and fire
          protection systems for commercial and residential projects. I performed load calculations and drafting, and
          researched ASHRAE 62.1 and 90.1 standards, IECC codes, and industry practices to apply them to real project
          conditions. I gained experience using Revit, AutoCAD, TRACE 700, IES-VE, and Bluebeam to develop, revise, and
          coordinate mechanical system drawings, BIM documentation, and project submittals. I also created custom Excel
          sheets that looked at demand-controlled ventilation, building pressurization, and exhaust airflow requirements.
        </p>
        <a class="btn" href={url('/experience/wsp/')}>See the internship</a>
      </div>
    </div>
    <div class="tiles">
      <a class="reveal" href={url('/experience/wsp/#site-visits')}>
        <Image src={wspSite} alt="" widths={[400, 700]} sizes="(max-width: 700px) 100vw, 33vw" />
        <span>Site visits</span>
      </a>
      <a class="reveal" href={url('/experience/wsp/#hawaii-prince-waikiki-spa-renovation')}>
        <Image src={wspPlan} alt="" widths={[400, 700]} sizes="(max-width: 700px) 100vw, 33vw" />
        <span>Hawaii Prince Waikiki Spa Renovation</span>
      </a>
      <a class="reveal" href={url('/experience/wsp/#excel-calculation-tools')}>
        <Image src={wspExcel} alt="" widths={[400, 700]} sizes="(max-width: 700px) 100vw, 33vw" />
        <span>Excel calculation tools</span>
      </a>
    </div>
  </section>

  <section class="section section-dark punahou-band" aria-labelledby="punahou-title">
    <div class="wrap">
      <div class="band-grid">
        <div class="reveal">
          <h2 id="punahou-title">Punahou School</h2>
          <p class="lead">
            Where I started engineering: a go-kart, a solar charger for a ride-on train, enrichment toys for the Honolulu Zoo,
            and machine shop competency tests.
          </p>
          <a class="btn" href={url('/punahou/')}>See Punahou projects</a>
        </div>
        <div class="band-ta reveal">
          <h3>Robotics Teaching Assistant</h3>
          <p>
            At Punahou School I supported fourth through sixth graders in their robotics journey, helping them both build
            robots and code them.
          </p>
          <a class="text-link" href={url('/experience/robotics-ta/')}>See the role <span class="arrow" aria-hidden="true"></span></a>
        </div>
      </div>
      <div class="tiles">
        {punahou.map((p) => (
          <a class="reveal" href={url(p.href)} style={[p.position && `--pos: ${p.position}`, p.fit && `--fit: ${p.fit}`].filter(Boolean).join('; ') || undefined}>
            <Image src={p.image} alt={p.alt} widths={[400, 700]} sizes="(max-width: 700px) 100vw, 33vw" />
            <span>{p.title}</span>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Full-width hero: photos crossfade with a slow zoom under a dark gradient */
  .hero {
    position: relative;
    min-height: clamp(500px, 80vh, 820px); /* short enough that the projects below start to show */
    display: flex;
    align-items: flex-end;
    overflow: hidden;
    background: var(--ink);
    color: #fff;
  }
  .slides { position: absolute; inset: 0; z-index: 0; }
  /* Each new photo wipes in from left to right over the last one, with a thin tan edge */
  .slide-frame {
    position: absolute; inset: 0;
    clip-path: inset(0 100% 0 0);
    z-index: 0;
  }
  .slide-frame.is-active { clip-path: inset(0 0 0 0); z-index: 2; }
  .slide-frame.is-entering { z-index: 3; animation: heroWipe 0.7s cubic-bezier(0.7, 0, 0.2, 1) forwards; }
  .slide-frame.is-leaving { clip-path: inset(0 0 0 0); z-index: 1; }
  .slide-frame::after {
    content: ''; position: absolute; top: 0; bottom: 0; right: 0; width: 3px; background: var(--accent);
    opacity: 0; z-index: 2;
  }
  .slide-frame.is-entering::after { opacity: 1; animation: heroEdge 0.9s linear forwards; }
  @keyframes heroWipe { from { clip-path: inset(0 100% 0 0); } to { clip-path: inset(0 0 0 0); } }
  @keyframes heroEdge { 0%, 85% { opacity: 1; } 100% { opacity: 0; } }
  .slide-frame :global(img) { width: 100%; height: 100%; object-fit: cover; object-position: var(--pos); }
  .slide-caption {
    position: absolute; right: clamp(16px, 4vw, 48px); bottom: clamp(16px, 3vw, 32px); z-index: 2;
    font-size: 0.7rem; font-weight: 600; letter-spacing: 0.16em; text-transform: uppercase; color: #fff;
    /* a small dark plate keeps the caption readable on any photo, light or dark */
    padding: 0.35em 0.7em; border-radius: 2px; background: rgba(20, 29, 40, 0.72);
  }
  /* Two overlays: dark (for white text) and light (for navy text). The hero's data-tone picks one. */
  .shade { position: absolute; inset: 0; z-index: 1; transition: opacity 0.6s var(--ease); }
  .shade-dark {
    background:
      linear-gradient(90deg, rgba(20, 29, 40, 0.9) 0%, rgba(20, 29, 40, 0.7) 45%, rgba(20, 29, 40, 0.28) 100%),
      linear-gradient(0deg, rgba(20, 29, 40, 0.75) 0%, rgba(20, 29, 40, 0) 55%);
  }
  /* Light photos: a soft warm-gray wash only behind the text (bottom left), fading out well before the middle */
  .shade-light {
    opacity: 0;
    background:
      radial-gradient(ellipse 80% 72% at 0% 100%, rgba(205, 203, 196, 0.84) 0%, rgba(205, 203, 196, 0.62) 50%, rgba(205, 203, 196, 0) 100%),
      linear-gradient(90deg, rgba(205, 203, 196, 0.35) 0%, rgba(205, 203, 196, 0) 50%);
  }
  .hero[data-tone='light'] .shade-dark { opacity: 0; }
  .hero[data-tone='light'] .shade-light { opacity: 1; }

  /* Text colors for each tone: white and light gray on dark photos, navy and charcoal on light ones */
  .hero { --hero-text: #fff; --hero-sub: #c9d0d7; --focus-ring: var(--accent); }
  .hero[data-tone='light'] { --hero-text: var(--ink); --hero-sub: var(--charcoal); --focus-ring: var(--ink); }
  .hero h1, .role, .school, .focus { transition: color 0.6s var(--ease), text-shadow 0.6s var(--ease); }
  .hero-content { position: relative; z-index: 3; padding-block: clamp(80px, 12vw, 140px) clamp(56px, 8vw, 96px); }
  .hero h1 {
    color: var(--hero-text);
    font-size: clamp(2.8rem, 7vw, 5.4rem);
    font-weight: 800;
    letter-spacing: 0.005em;
    margin-bottom: 0.2em;
    text-shadow: 0 2px 24px rgba(0, 0, 0, 0.25);
  }
  /* a faint light glow keeps navy text clear where the photo behind it is darker */
  .hero[data-tone='light'] h1 { text-shadow: 0 1px 18px rgba(225, 223, 217, 0.7); }
  .hero[data-tone='light'] .role, .hero[data-tone='light'] .school, .hero[data-tone='light'] .focus { text-shadow: 0 1px 10px rgba(225, 223, 217, 0.8); }
  .role { margin: 0 0 0.6em; font-size: clamp(0.85rem, 1.4vw, 1rem); font-weight: 600; letter-spacing: 0.24em; color: var(--hero-text); }
  /* Degree and graduation date: the first thing a recruiter checks */
  .school .nowrap { white-space: nowrap; }
  .school { margin: 0 0 1.1em; max-width: 46ch; font-size: clamp(1rem, 1.7vw, 1.2rem); font-weight: 500; line-height: 1.4; text-wrap: balance; color: var(--hero-text); }
  .focus { font-size: 0.74rem; font-weight: 600; letter-spacing: 0.1em; text-wrap: balance; text-transform: uppercase; color: var(--hero-sub); margin-bottom: 2em; }
  .hero-btns { display: flex; flex-wrap: wrap; gap: 12px; }
  .hero-btns .btn { min-width: 180px; background: #fff; color: var(--ink); border-color: #fff; transition: background 0.6s var(--ease), color 0.6s var(--ease), border-color 0.6s var(--ease), transform 0.2s var(--ease); }
  .hero[data-tone='light'] .hero-btns .btn { background: var(--ink); color: #fff; border-color: var(--ink); }
  /* LinkedIn is the secondary action: outlined instead of filled */
  .hero-btns .btn.btn-line, .hero[data-tone='light'] .hero-btns .btn.btn-line { background: transparent; color: var(--hero-text); border-color: currentColor; }
  .hero-btns .btn:hover, .hero-btns .btn.btn-line:hover { background: var(--accent); border-color: var(--accent); color: var(--ink); }
  @media (max-width: 560px) {
    .hero-btns { display: grid; grid-template-columns: 1fr 1fr; }
    .hero-btns .btn { min-width: 0; }
    .hero-btns .btn-line { grid-column: 1 / -1; }
  }

  /* Reduced motion: the script leaves the first photo up and never switches */
  @media (prefers-reduced-motion: reduce) {
    .slide-frame.is-entering, .slide-frame.is-entering::after { animation: none !important; }
  }

  /* About section: headshot on one side, text on the other */
  .about {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: clamp(32px, 5vw, 64px);
    align-items: stretch; /* photo runs the full height of the text */
    padding-block: clamp(72px, 10vw, 130px);
    overflow-x: clip;
  }
  .about-photo { position: relative; min-height: 420px; }
  .about-photo :global(img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 50% 12%; border-radius: 4px; }
  .about-text { position: relative; padding: 0; display: flex; flex-direction: column; }
  .about-text h2 { position: relative; z-index: 1; font-size: clamp(2rem, 4vw, 3rem); margin: -0.12em 0 0.45em; line-height: 1; }
  .about-copy { position: relative; z-index: 1; max-width: 62ch; text-align: left; }
  .about-copy p { font-size: 1.02rem; margin: 0 0 1em; }
  .about-copy p:last-child { margin-bottom: 0; }
  .facts-row { position: relative; z-index: 1; margin: 1.4em 0 0; font-size: 0.74rem; font-weight: 600; letter-spacing: 0.1em; text-wrap: balance; text-transform: uppercase; color: var(--steel); }
  .about-cta { position: relative; z-index: 1; margin-top: 28px; }

  /* Faint line drawings, kept out at the edges and never behind the heading */
  .sketches { position: absolute; inset: 0; pointer-events: none; }
  .sk { position: absolute; height: auto; opacity: 0.12; }
  .sk-a { width: 250px; bottom: calc(100% + 4px); right: -70px; }
  .sk-b { width: 210px; top: calc(100% + 4px); right: -40px; }
  .sk-c { width: 120px; top: 30%; right: -150px; }
  @media (max-width: 1240px) { .sk-c { display: none; } .sk-a { right: -20px; } .sk-b { right: -10px; width: 170px; } }

  @media (max-width: 860px) {
    .about { grid-template-columns: 1fr; padding-top: 56px; }
    .about-photo { max-width: 420px; margin-inline: auto; width: 100%; min-height: 0; aspect-ratio: 4 / 5; }
    .sketches { display: none; }
  }

  .section-tight { padding-block: clamp(48px, 7vw, 88px) clamp(56px, 8vw, 96px); background: var(--white); border-block: 1px solid var(--mist); }

  /* Featured projects: three columns, each ending in a Predicted / Measured table.
     The tables sit at the bottom of each column so they line up across the row. */
  .featured-head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 8px 24px; margin-bottom: clamp(24px, 3vw, 40px); }
  .featured-head h2 { margin: 0; }
  .all-link, .text-link { display: inline-flex; align-items: center; gap: 10px; font-weight: 600; font-size: 0.95rem; }
  .arrow { position: relative; width: 16px; height: 1.5px; background: currentColor; transition: transform 0.2s var(--ease); }
  .arrow::after { content: ''; position: absolute; right: 0; top: -3.5px; width: 7px; height: 7px; border-top: 1.5px solid currentColor; border-right: 1.5px solid currentColor; transform: rotate(45deg); }
  .all-link:hover .arrow, .text-link:hover .arrow { transform: translateX(3px); }

  .featured-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(28px, 3.5vw, 48px); margin: 0; padding: 0; list-style: none; }
  .fcard { position: relative; display: flex; flex-direction: column; }
  .fcard-media { display: block; aspect-ratio: 4 / 3; overflow: hidden; border-radius: var(--radius); background: #e7e6e1; margin-bottom: 18px; }
  .fcard-media :global(img) { width: 100%; height: 100%; object-fit: cover; object-position: var(--pos, 50% 50%); transition: transform 0.6s var(--ease); }
  .fcard:hover .fcard-media :global(img) { transform: scale(1.03); }
  .fcard-body { display: flex; flex-direction: column; flex: 1; }
  .fcard h3 { margin: 0 0 4px; font-size: clamp(1.25rem, 1.8vw, 1.45rem); font-weight: 800; text-wrap: balance; }
  .fcard h3 a { color: var(--ink); text-decoration: none; }
  /* The title link covers the whole column, so the photo and table are clickable too */
  .fcard h3 a::after { content: ''; position: absolute; inset: -8px; border-radius: 6px; }
  .fcard:hover h3 a { text-decoration: underline; }
  .fcard h3 a:focus-visible { outline: none; }
  .fcard h3 a:focus-visible::after { outline: 2px solid var(--ink); outline-offset: 2px; }
  .fcard-meta { margin: 0 0 12px; font-size: 0.86rem; color: var(--charcoal); }
  .fcard-summary { margin: 0 0 22px; font-size: 0.95rem; }
  .results { margin: auto 0 0; border-top: 1.5px solid var(--ink); }
  .results div { display: flex; align-items: baseline; justify-content: space-between; gap: 16px; padding: 9px 0; border-bottom: 1px solid var(--mist); }
  .results dt { font-size: 0.72rem; font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase; color: var(--charcoal); }
  .results dd { margin: 0; text-align: right; font-size: 0.98rem; font-weight: 500; font-variant-numeric: tabular-nums; color: var(--charcoal); }
  .results div:last-child dd { font-size: 1.12rem; font-weight: 800; color: var(--ink); }
  .results-note { margin: 10px 0 0; font-size: 0.85rem; line-height: 1.5; color: var(--charcoal); }

  /* Desktop: the columns share rows, so titles, tables and notes line up across all three
     even when one summary or note is longer than the others */
  @media (min-width: 961px) {
    .featured-grid { row-gap: 0; }
