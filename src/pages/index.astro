---
// The home page. It has its own look, separate from the rest of the site for now:
// an aerospace and defense company. Graphite, flight-deck olive and paper,
// with the work itself (photos of real hardware) carrying the colour.
// Type: Archivo, its expanded capitals for headlines and normal width for text.
// As you scroll, the whole page changes colour chapter by chapter, the first photo
// pulls back into a frame, and the three test results pin and swap in place.
import '@fontsource-variable/archivo/wdth.css';
import { Image } from 'astro:assets';
import { getCollection, getEntry } from 'astro:content';
import { url } from '../lib/url';
import { site } from '../lib/site';
import { categories } from '../lib/categories';
import { featured } from '../lib/featured';
import { ogFile } from '../lib/og';
import { shortDescription } from '../lib/og-image';
import headshot from '../assets/headshot.jpg';
import heroPhoto from '../content/projects/rope-climbing-robot/01_river_crossing_wide.jpg';
import gearTrain from '../content/projects/rope-climbing-robot/09_gear_train_top_view.jpg';
import wspRoom from '../content/experience/wsp/halekulani_12.jpg';

// The three featured projects, with their measured results from src/lib/featured.ts
const featuredCards = await Promise.all(
  featured.map(async (f) => {
    const entry = await getEntry('projects', f.slug);
    if (!entry) throw new Error(`Featured project "${f.slug}" not found in src/content/projects/`);
    return { ...f, ...entry.data, href: `/projects/${f.slug}/` };
  }),
);

// More work: one tile each, with the number that project is known for where it has one
// (the rest are in the full list further down)
const moreSlugs = [
  { slug: 'sae-aero', figure: 'In progress' },
  { slug: 'hydraulic-system', figure: '23.4 m pump head' },
];
const moreTiles = await Promise.all(
  moreSlugs.map(async (m) => {
    const entry = await getEntry('projects', m.slug);
    if (!entry) throw new Error(`Project "${m.slug}" not found in src/content/projects/`);
    return { ...m, ...entry.data, href: `/projects/${m.slug}/` };
  }),
);

// Every project and role, for the filterable list (placeholders stay off the home page)
type Row = { title: string; course: string; date: string; href: string; cover?: ImageMetadata; coverPosition?: string; fields: string[] };
const experienceRows: Row[] = (await getCollection('experience'))
  .filter((e) => e.data.categories.length > 0)
  .sort((a, b) => a.data.order - b.data.order)
  .map((e) => ({
    title: `${e.data.organization.replace(/ in the US$/, '')} internship`,
    course: e.data.title,
    date: e.data.dates.replace(/^\w+ (\d{4}) to \w+ (\d{4})$/, '$1 to $2'),
    href: `/experience/${e.id}/`,
    cover: e.data.cover,
    coverPosition: e.data.coverPosition,
    fields: e.data.categories.map((c) => c.category),
  }));
const projectRows: Row[] = (await getCollection('projects'))
  .filter((p) => !p.data.placeholder)
  .sort((a, b) => a.data.order - b.data.order)
  .map((p) => ({
    title: p.data.title,
    course: p.data.course ?? p.data.role,
    date: p.data.date,
    href: `/projects/${p.id}/`,
    cover: p.data.cover ?? p.data.gallery?.[0]?.images?.[0]?.src,
    coverPosition: p.data.coverPosition,
    fields: p.data.categories.map((c) => c.category),
  }));
const rows = [...experienceRows, ...projectRows];
const fields = categories.filter((c) => rows.some((r) => r.fields.includes(c.slug)));
const firstWithPhoto = rows.find((r) => r.cover)!;

const punahou = [
  { name: 'Go-Kart', detail: 'Engineering III', href: '/punahou/engineering-iii/go-kart/' },
  { name: 'Lanakila Express', detail: 'Solar charger, tracks, couplings', href: '/punahou/#lanakila-express' },
  { name: 'Waikiki Zootopia', detail: 'Zoo enrichment toys', href: '/punahou/ke-kilohana/waikiki-zootopia/' },
  { name: 'Machine shop tests', detail: 'Mill and lathe', href: '/punahou/#competency-tests' },
  { name: 'Robotics TA', detail: 'Grades 4 to 6', href: '/experience/robotics-ta/' },
];
const wspSoftware = ['Revit', 'AutoCAD', 'TRACE 700', 'IES-VE', 'Bluebeam', 'Excel'];
const wspStandards = ['ASHRAE 62.1', 'ASHRAE 90.1', 'IECC', 'UPC'];
const [emailUser, emailHost] = site.email.split('@');

// Search results and link previews, the same as every other page (see BaseLayout.astro)
const description = shortDescription(site.description);
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(url(`/og/${ogFile('')}`), Astro.site);

// The main menu: the same places as the menu on every other page
const nav = [
  { label: 'Work', href: '#work' },
  { label: 'Projects', href: url('/projects/') },
  { label: 'Experience', href: url('/experience/') },
  { label: 'Resume', href: url('/resume/') },
  { label: 'Contact', href: url('/contact/') },
];
---

<!doctype html>
<html lang="en" class="no-js" data-ground="graphite">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{site.title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
    <meta name="theme-color" content="#0d0e10" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={site.title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${site.name}, mechanical engineer`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={site.title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <script is:inline>document.documentElement.classList.remove('no-js');</script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <!-- One fixed colour layer behind the page; it changes colour as each chapter arrives -->
    <div class="ground" aria-hidden="true"></div>

    <header class="bar">
      <a class="wordmark" href={url('/')}>{site.name}</a>
      <nav aria-label="Main">
        <ul class="nav-links">
          {nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
          <li><a class="btn btn-small" href={`mailto:${site.email}`}>Email me</a></li>
        </ul>
        <!-- Phones: the same links in a full-screen menu -->
        <button class="menu-btn" type="button" aria-expanded="false" aria-controls="phone-menu">Menu</button>
      </nav>
      <div class="phone-menu" id="phone-menu" hidden>
        <ul>
          {nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
          <li><a href={site.linkedin} target="_blank" rel="noopener">LinkedIn</a></li>
        </ul>
        <a class="btn" href={`mailto:${site.email}`}>Email me <span class="arrow" aria-hidden="true"></span></a>
      </div>
    </header>

    <main id="main">
      <!-- Chapter 1, graphite: the work in the field, full screen, then pulled back into a frame -->
      <section class="hero" data-chapter="graphite" aria-labelledby="hero-title">
        <div class="hero-stage">
          <div class="hero-photo">
            <Image src={heroPhoto} alt="The Rope Climbing Robot crossing the test course along a rope above water" widths={[900, 1400, 2000, 2600]} sizes="100vw" loading="eager" fetchpriority="high" />
          </div>
          <div class="hero-shade" aria-hidden="true"></div>
          <div class="hero-copy">
            <h1 id="hero-title">
              <span class="line"><span>Kasin</span></span>
              <span class="line"><span>Ito-Sato</span></span>
            </h1>
            <!-- Role, then degree and graduation date on their own line: the first things a recruiter checks -->
            <p class="hero-role">Mechanical Engineer</p>
            <p class="hero-degree">BS Mechanical Engineering, <span class="nowrap">Loyola Marymount University</span><span class="sep"> · </span><span class="nowrap">May 2027</span></p>
            <p class="hero-line">Build it, measure it. I design and build hardware, then test it against my own predictions.</p>
            <div class="hero-actions">
              <a class="btn" href="#work">See the work <span class="arrow" aria-hidden="true"></span></a>
              <a class="text-link" href={url('/resume/')}>Resume</a>
              <a class="text-link" href={site.linkedin} target="_blank" rel="noopener">LinkedIn</a>
            </div>
          </div>
          <p class="hero-caption">Rope Climbing Robot on the test course, Spring 2026</p>
        </div>
      </section>

      <section class="intro" data-chapter="graphite" aria-labelledby="intro-title">
        <h2 id="intro-title" class="visually-hidden">About</h2>
        <div class="intro-grid">
          <p class="lead" data-rise>
            I'm a fourth-year mechanical engineering student at Loyola Marymount University and on our team for the 2027
            SAE Aero Design Regular Class competition. I grew up on Oahu, learning to machine, weld and wire in the
            Punahou School shop.
          </p>
          <div class="portrait" data-rise>
            <Image src={headshot} alt="Portrait of Kasin Ito-Sato" widths={[360, 540, 720]} sizes="(max-width: 760px) 40vw, 20vw" quality={90} />
          </div>
          <dl class="facts">
            <div data-rise><dt>Studying</dt><dd>BS Mechanical Engineering, Loyola Marymount University, May 2027. FE Mechanical exam in November 2026.</dd></div>
            <div data-rise><dt>Working on</dt><dd>Mechanical design and CAD, thermal and flow analysis, assembly and test, GD&T.</dd></div>
            <div data-rise><dt>Based in</dt><dd>Los Angeles, CA. Grew up in Honolulu. English and Japanese.</dd></div>
            <div data-rise><dt>Looking for</dt><dd>A full-time role after I graduate where I can keep designing, building and testing.</dd></div>
          </dl>
        </div>
      </section>

      <!-- Chapter 1 continues: three results side by side, so they can be compared in one look -->
      <section class="tests" id="work" data-chapter="graphite" aria-labelledby="tests-title">
        <div class="tests-head">
          <h2 id="tests-title" class="title" data-rise>Built, then measured</h2>
          <p class="tests-sub" data-rise>Three builds where I predicted the result first, then tested it.</p>
        </div>
        <ol class="tests-grid">
          {featuredCards.map((f) => (
            <li class="test" data-rise>
              <a class="test-photo" href={url(f.href)} tabindex="-1" aria-hidden="true" style={f.coverPosition && `--pos: ${f.coverPosition}`} data-reveal>
                {f.cover && <Image src={f.cover} alt="" widths={[500, 800, 1100]} sizes="(max-width: 640px) 100vw, (max-width: 960px) 45vw, 32vw" />}
              </a>
              <h3><a href={url(f.href)}>{f.title}</a></h3>
              <p class="test-meta">{[f.course, f.date].filter(Boolean).join(' · ')}</p>
              <dl class="readout">
                {f.results.map((r) => (
                  <div>
                    <dt>{r.label}</dt>
                    <dd>{r.value}</dd>
                  </div>
                ))}
              </dl>
              <p class="test-note">{f.note}</p>
            </li>
          ))}
        </ol>
      </section>

      <!-- More work, as a mosaic of tiles -->
      <section class="mosaic" data-chapter="graphite" aria-labelledby="more-title">
        <h2 id="more-title" class="title" data-rise>More work</h2>
        <ul class="tiles">
          <li class="tile tile-wide" data-reveal>
            <a href={url('/projects/rope-climbing-robot/')}>
              <span class="tile-photo"><Image src={gearTrain} alt="" widths={[700, 1100, 1500]} sizes="(max-width: 760px) 100vw, 66vw" /></span>
              <span class="tile-text">
                <span class="tile-name">Inside the rope climber</span>
                <span class="tile-line">Gear train and screw-slider drive, laser-cut and 3D printed</span>
              </span>
              <span class="tile-arrow" aria-hidden="true"></span>
            </a>
          </li>
          {moreTiles.map((t) => (
            <li class="tile" data-reveal>
              <a href={url(t.href)}>
                <span class="tile-photo" style={t.coverPosition && `--pos: ${t.coverPosition}`}>
                  {t.cover && <Image src={t.cover} alt="" widths={[500, 800]} sizes="(max-width: 760px) 100vw, 33vw" />}
                </span>
                <span class="tile-text">
                  <span class="tile-name">{t.title}</span>
                  <span class="tile-line">{t.figure}</span>
                </span>
                <span class="tile-arrow" aria-hidden="true"></span>
              </a>
            </li>
          ))}
        </ul>
      </section>

      <!-- Chapter 2, flight-deck olive: the internship -->
      <section class="wsp" id="wsp" data-chapter="olive" aria-labelledby="wsp-title">
        <div class="wsp-head">
          <h2 id="wsp-title" class="title" data-rise>Intern at WSP</h2>
          <dl class="side-facts" data-rise>
            <div><dt>Role</dt><dd>Mechanical Engineering Intern</dd></div>
            <div><dt>Where</dt><dd>WSP in the US, Honolulu, HI</dd></div>
            <div><dt>When</dt><dd>May 2025 to January 2026</dd></div>
          </dl>
        </div>
        <figure class="wsp-photo" data-reveal>
          <Image src={wspRoom} alt="A building mechanical room with red and blue piping and pumps, seen on a WSP site visit" widths={[900, 1400, 2000, 2600]} sizes="100vw" />
        </figure>
        <div class="wsp-figure">
          <p class="big" data-rise>0.0026 <span class="unit">in. w.c.</span></p>
          <div class="wsp-figure-text">
            <h3 data-rise>The rule of thumb, checked</h3>
            <p data-rise>
              With the team's 10% rule of thumb, my Excel pressurization tool showed a 40,000 sq ft office reaching
              0.0026 in. w.c., under the 0.02 in. w.c. minimum. It was one of three calculation tools I built that the
              team adopted.
            </p>
          </div>
        </div>
        <div class="wsp-body">
          <p class="lead" data-rise>
            I worked with licensed mechanical engineers to design HVAC, plumbing and fire protection systems for
            commercial and residential projects. I sized equipment from loads cross-checked in IES-VE and TRACE 700 and
            drafted layouts for the Hawaii Prince Waikiki Spa Renovation.
          </p>
          <div class="records" data-rise>
            <div>
              <h3>Software</h3>
              <ul>{wspSoftware.map((t) => <li>{t}</li>)}</ul>
            </div>
            <div>
              <h3>Standards and codes</h3>
              <ul>{wspStandards.map((t) => <li>{t}</li>)}</ul>
            </div>
          </div>
          <a class="text-link" href={url('/experience/wsp/')} data-rise>See the internship <span class="arrow" aria-hidden="true"></span></a>
        </div>
      </section>

      <!-- Chapter 3, paper: the full record -->
      <section class="ledger" id="all" data-chapter="paper" aria-labelledby="ledger-title">
        <div class="ledger-col">
          <h2 id="ledger-title" class="title" data-rise>Everything I've worked on</h2>
          <nav class="fields" aria-label="Show work in one field" data-rise>
            <a href={url('/projects/')} data-field="" aria-current="true">All</a>
            {fields.map((c) => <a href={url(`/projects/${c.slug}/`)} data-field={c.slug}>{c.name}</a>)}
          </nav>
          <p class="ledger-count" aria-live="polite" data-count>{rows.length} projects and roles</p>
          <ol class="rows">
            {rows.map((r) => (
              <li data-fields={r.fields.join(' ')}>
                <a href={url(r.href)}>
                  {r.cover && (
                    <span class="row-photo" style={r.coverPosition && `--pos: ${r.coverPosition}`}>
                      <Image src={r.cover} alt="" widths={[400, 640]} sizes="(max-width: 760px) 100vw, 320px" />
                    </span>
                  )}
                  <span class="row-name">{r.title}</span>
                  <span class="row-kind">{r.course}</span>
                  <span class="row-date">{r.date}</span>
                </a>
              </li>
            ))}
          </ol>
          <a class="text-link" href={url('/projects/')} data-field-link>See all projects with photos <span class="arrow" aria-hidden="true"></span></a>
        </div>
        <figure class="preview" aria-hidden="true">
          <div class="preview-frame">
            {firstWithPhoto.cover && <Image src={firstWithPhoto.cover} alt="" widths={[500, 800]} sizes="30vw" data-preview-img />}
          </div>
          <figcaption data-preview-cap>{firstWithPhoto.title}</figcaption>
        </figure>
      </section>

      <section class="punahou" data-chapter="paper" aria-labelledby="punahou-title">
        <h2 id="punahou-title" class="title" data-rise>Where I started: Punahou School</h2>
        <ul>
          {punahou.map((p) => (
            <li data-rise>
              <a href={url(p.href)}>
                <h3>{p.name}</h3>
                <span>{p.detail}</span>
                <span class="arrow" aria-hidden="true"></span>
              </a>
            </li>
          ))}
        </ul>
        <a class="text-link" href={url('/punahou/')} data-rise>See every Punahou project <span class="arrow" aria-hidden="true"></span></a>
      </section>
    </main>

    <!-- Chapter 4, graphite again: the way to reach me is the headline -->
    <footer class="close" data-chapter="graphite" aria-labelledby="close-title">
      <h2 id="close-title" class="close-title">Get in touch</h2>
      <a class="mail" href={`mailto:${site.email}`}><span>{emailUser}</span><span>@{emailHost}</span></a>
      <div class="close-meta">
        <p>Mechanical Engineer<br />BS Loyola Marymount University, May 2027</p>
        <p>Los Angeles, CA<br />English and Japanese</p>
        <p><a href={site.linkedin} target="_blank" rel="noopener">LinkedIn</a><br /><a href={url('/resume/')}>Resume</a></p>
        <p><a href="#main">Back to top</a><br />© 2026 {site.name}</p>
      </div>
    </footer>

    <style is:global>
      :root {
        /* Grounds, one per chapter, each with its own text colours */
        --graphite: #0d0e10;
        --graphite-up: #17191c;   /* a step up, for tiles and panels */
        --olive: #45473e;
        --olive-up: #51544a;
        --paper: #e8e7e2;
        --paper-up: #dddcd6;
        --on-dark: #f2f2ef;
        --on-dark-soft: #a9abad;
        --on-olive-soft: #c9cabd;
        --on-paper: #0d0e10;
        --on-paper-soft: #55575b;

        --font: 'Archivo Variable', 'Helvetica Neue', Arial, sans-serif;

        /* The five type sizes */
        --step-small: 0.875rem;
        --step-body: clamp(1.0625rem, 1rem + 0.2vw, 1.1875rem);
        --step-lead: clamp(1.25rem, 0.95rem + 1vw, 1.875rem);
        --step-head: clamp(2rem, 1rem + 3.2vw, 4.25rem);
        --step-display: clamp(3.25rem, 0.75rem + 7.6vw, 9rem);

        --margin: max(clamp(16px, 3vw, 48px), env(safe-area-inset-left, 0px), env(safe-area-inset-right, 0px));
        --gap: clamp(88px, 10vw, 160px);
        --ease-out: cubic-bezier(0.23, 1, 0.32, 1);
        --ease-in-out: cubic-bezier(0.77, 0, 0.175, 1);
        --chapter-ms: 700ms;
      }
      *, *::before, *::after { box-sizing: border-box; }
      html { -webkit-text-size-adjust: 100%; -webkit-tap-highlight-color: transparent; scroll-behavior: smooth; scroll-padding-top: 72px; }
      /* Taps register at once (no double-tap-zoom wait); controls don't select their label on a long press */
      a, button { touch-action: manipulation; }
      .btn, .fields a, .bar a, .phone-menu a { -webkit-user-select: none; user-select: none; -webkit-touch-callout: none; }
      @media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } }
      body {
        margin: 0; font: 400 var(--step-body)/1.55 var(--font); font-stretch: 100%;
        color: var(--ink); --ink: var(--on-dark); --soft: var(--on-dark-soft); --up: var(--graphite-up);
        transition: color var(--chapter-ms) var(--ease-in-out);
        overflow-x: clip;
      }
      /* Chapter colours: the fixed ground and the text change together */
      html[data-ground='olive'] body { --ink: var(--on-dark); --soft: var(--on-olive-soft); --up: var(--olive-up); }
      html[data-ground='paper'] body { --ink: var(--on-paper); --soft: var(--on-paper-soft); --up: var(--paper-up); }
      .ground { position: fixed; inset: 0; z-index: -1; background-color: var(--graphite); transition: background-color var(--chapter-ms) var(--ease-in-out); }
      html[data-ground='olive'] .ground { background-color: var(--olive); }
      html[data-ground='paper'] .ground { background-color: var(--paper); }
      /* Without JavaScript each chapter simply carries its own colour */
      .no-js [data-chapter='graphite'] { background: var(--graphite); color: var(--on-dark); }
      .no-js [data-chapter='olive'] { background: var(--olive); color: var(--on-dark); }
      .no-js [data-chapter='paper'] { background: var(--paper); color: var(--on-paper); }

      ::selection { background: var(--ink); color: var(--graphite); }
      html[data-ground='paper'] ::selection { color: var(--paper); }
      img { display: block; max-width: 100%; height: auto; }
      a { color: inherit; text-decoration-thickness: 1px; text-underline-offset: 4px; }
      :focus-visible { outline: 2px solid currentColor; outline-offset: 4px; }
      h1, h2, h3, p, figure, dl, dd { margin: 0; }
      p { text-wrap: pretty; }
      .visually-hidden { position: absolute !important; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
      .skip { position: absolute; left: -999px; top: 8px; z-index: 60; padding: 10px 16px; background: var(--on-dark); color: var(--graphite); }
      .skip:focus { left: 8px; }

      /* Headlines: Archivo stretched wide, in capitals */
      .title {
        font-size: var(--step-head); font-weight: 650; font-stretch: 118%; line-height: 0.98; letter-spacing: -0.02em;
        text-transform: uppercase; text-wrap: balance;
      }

      /* Buttons: flat, square, with a drawn arrow */
      .btn {
        display: inline-flex; align-items: center; gap: 14px; min-height: 52px; padding: 0 22px;
        background: var(--on-dark); color: var(--graphite); font-size: var(--step-small); font-weight: 600; text-decoration: none;
        transition: transform 160ms var(--ease-out), background-color 200ms ease;
      }
      .btn:active { transform: scale(0.97); }
      .btn-small { min-height: 40px; padding: 0 16px; }
      .arrow { position: relative; display: inline-block; width: 18px; height: 1.5px; background: currentColor; transition: transform 200ms var(--ease-out); }
      .arrow::after { content: ''; position: absolute; right: 0; top: -4px; width: 8px; height: 8px; border-top: 1.5px solid currentColor; border-right: 1.5px solid currentColor; transform: rotate(45deg); }
      .text-link { display: inline-flex; align-items: center; gap: 12px; font-size: var(--step-small); font-weight: 600; text-decoration: none; min-height: 44px; }
      @media (hover: hover) and (pointer: fine) {
        .btn:hover { background: #ffffff; }
        .btn:hover .arrow, .text-link:hover .arrow { transform: translateX(4px); }
        .text-link:hover { text-decoration: underline; }
      }

      /* ---------- Top bar: it takes the colour of the chapter you're in ---------- */
      .bar {
        position: fixed; top: 0; left: 0; right: 0; z-index: 50;
        display: flex; align-items: center; justify-content: space-between; gap: 24px;
        padding: 12px var(--margin); padding-top: max(12px, env(safe-area-inset-top));
        color: var(--on-dark); mix-blend-mode: normal;
      }
