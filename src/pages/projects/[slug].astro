---
// Makes two kinds of pages under /projects/:
//   /projects/<project folder>/  one page per project (layout in src/components/ProjectDetail.astro)
//   /projects/<skill>/           the Projects page with that skill filter on, like /projects/thermal/
// You never need to edit this file to add a project or a skill category.
import { getCollection } from 'astro:content';
import ProjectDetail from '../../components/ProjectDetail.astro';
import ProjectsPage from '../../components/ProjectsPage.astro';
import { categories } from '../../lib/categories';

export async function getStaticPaths() {
  const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
  const clash = projects.find((p) => categories.some((c) => c.slug === p.id));
  if (clash) throw new Error(`The project folder "${clash.id}" has the same name as a skill category. Rename one of them.`);
  return [
    ...projects.map((entry, i) => ({
      params: { slug: entry.id },
      props: { entry, prev: projects[i - 1], next: projects[i + 1] },
    })),
    ...categories.map((c) => ({ params: { slug: c.slug }, props: { skill: c.slug } })),
  ];
}

const props = Astro.props;
---

{'skill' in props ? <ProjectsPage active={props.skill} /> : <ProjectDetail entry={props.entry} prev={props.prev} next={props.next} />}
