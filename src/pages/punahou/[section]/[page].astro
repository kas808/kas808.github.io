---
// Template for every Punahou page. Text and photos come from
// src/content/punahou/<section>/<page>/index.md
import { Image } from 'astro:assets';
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import YouTube from '../../../components/YouTube.astro';
import { url } from '../../../lib/url';
import { punahouSections } from '../../../lib/site';
import SkillChips from '../../../components/SkillChips.astro';
import { pageCategories } from '../../../lib/category-cards';

export async function getStaticPaths() {
  const pages = (await getCollection('punahou')).sort((a, b) => a.data.order - b.data.order);
  return pages.map((entry) => {
    const [section, page] = entry.id.split('/');
    const siblings = pages.filter((p) => p.data.section === entry.data.section && (!p.data.hidden || p === entry));
    const i = siblings.indexOf(entry);
    return { params: { section, page }, props: { entry, prev: siblings[i - 1], next: siblings[i + 1] } };
  });
}

const { entry, prev, next } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
const sectionName = punahouSections.find((s) => s.id === d.section)?.name ?? '';
---

<BaseLayout title={`${d.title} | Punahou`} description={`${d.title}: a ${sectionName} project from Punahou School.`} noindex={d.hidden}>
  <article>
    {d.banner ? (
      <header class="banner">
        <Image src={d.banner} alt="" widths={[800, 1400, 2000]} sizes="100vw" loading="eager" />
        <div class="banner-text wrap">
          <nav class="crumbs" aria-label="Breadcrumb">
            <a href={url('/punahou/')}>Punahou School</a> / <a href={url(`/punahou/#${d.section}`)}>{sectionName}</a>
          </nav>
          <h1>{d.title}</h1>
          <div class="skill-tags"><SkillChips small onDark label="Skill areas" only={pageCategories(d)} /></div>
        </div>
      </header>
    ) : (
      <header class="page-head wrap">
        <nav class="crumbs plain" aria-label="Breadcrumb">
          <a href={url('/punahou/')}>Punahou School</a> / <a href={url(`/punahou/#${d.section}`)}>{sectionName}</a>
        </nav>
        <h1>{d.title}</h1>
        <div class="skill-tags"><SkillChips small label="Skill areas" only={pageCategories(d)} /></div>
      </header>
    )}

    <div class="wrap content">
      <div class="prose">
        <Content />
      </div>

      {d.youtube.length > 0 && (
        <section class="extra">
          <h2>Video</h2>
          {d.youtube.map((v) => <YouTube link={v.url} title={v.title} />)}
        </section>
      )}

      {d.links.length > 0 && (
        <section class="extra">
          <h2>Files</h2>
          <ul class="file-links">
            {d.links.map((l) => <li><a class="btn btn-ghost" href={l.url} target="_blank" rel="noopener">{l.title}</a></li>)}
          </ul>
        </section>
      )}
    </div>

    <nav class="pager wrap" aria-label={`More from ${sectionName}`}>
      {prev ? <a href={url(`/punahou/${prev.id}/`)}><span class="eyebrow">Previous</span>{prev.data.title}</a> : <span />}
      {next ? <a class="next" href={url(`/punahou/${next.id}/`)}><span class="eyebrow">Next</span>{next.data.title}</a> : <a class="next" href={url('/punahou/')}><span class="eyebrow">Back to</span>Punahou School</a>}
    </nav>
  </article>
</BaseLayout>

<style>
  .banner { position: relative; height: clamp(260px, 46vw, 520px); overflow: hidden; background: var(--ink); }
  .banner :global(img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0.72; }
  .banner::after { content: ''; position: absolute; inset: 0; background: linear-gradient(180deg, rgba(37, 52, 71, 0.1) 30%, rgba(37, 52, 71, 0.85)); }
  .banner-text { position: absolute; left: 0; right: 0; bottom: 0; z-index: 1; padding-bottom: clamp(24px, 4vw, 48px); }
  .banner h1 { color: #fff; margin: 0; }
  .crumbs { font-size: 0.8rem; color: #dfe3e7; margin-bottom: 12px; }
  .crumbs a { color: #dfe3e7; }
  .crumbs.plain, .crumbs.plain a { color: var(--steel); }
  .content { padding-block: clamp(32px, 5vw, 64px); }
  .content .prose { margin-inline: auto; max-width: 820px; }
  .content .prose :global(img) { width: 100%; }
  .extra { max-width: 820px; margin: 48px auto 0; }
  .file-links { list-style: none; padding: 0; display: flex; flex-wrap: wrap; gap: 12px; }
  .pager { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; padding-block: 48px 80px; border-top: 1px solid var(--mist); }
  .pager a { display: flex; flex-direction: column; gap: 4px; text-decoration: none; font-weight: 700; font-size: 1.1rem; color: var(--ink); }
  .pager .eyebrow { margin: 0; }
  .pager .next { text-align: right; align-items: flex-end; }
  .skill-tags { margin-top: 14px; }
  .skill-tags:empty { display: none; }
</style>
