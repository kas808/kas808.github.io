---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import { url } from '../lib/url';
import { site } from '../lib/site';
import resumePage from '../assets/resume-page.png';
import p1 from '../content/projects/pantograph/01_pantograph_final_build.jpg';
import p2 from '../content/projects/wind-turbine/01_final_turbine_photo.jpg';
import p3 from '../content/projects/rube-goldberg/01_final_machine.jpg';
import p4 from '../content/projects/water-filter/01_filter_testing.jpg';
import p5 from '../content/experience/robotics-ta/03.jpg';

const pdf = url(site.resumePdf);
const portfolio = url('media/resume/Kasin-Ito-Sato-Project-Portfolio.pdf');
---

<BaseLayout title="Resume" description="Resume of Kasin Ito-Sato, mechanical engineer.">
  <header class="page-head wrap center">
    <h1>Resume.</h1>
    <p class="lead">
      I'm a mechanical engineering student at Loyola Marymount University, graduating in May 2027. I'm most interested in
      mechanical design, thermal and flow analysis, and assembly and test, with hands-on experience in GD&T, machining
      and HVAC design.
    </p>
    <div class="btn-row centered">
      <a class="btn" href={pdf} download>Download resume (PDF)</a>
      <a class="btn btn-ghost" href={portfolio} target="_blank" rel="noopener">2-page project portfolio</a>
    </div>
  </header>

  <section class="wrap resume-grid">
    <a class="paper reveal" href={pdf} target="_blank" rel="noopener" title="Open the resume PDF">
      <Image
        src={resumePage}
        alt="Kasin Ito-Sato's one-page resume. Open or download the PDF for selectable text."
        widths={[600, 900, 1300, 1854]}
        sizes="(max-width: 900px) 100vw, 680px"
        loading="eager"
      />
    </a>
    <div class="collage reveal" aria-label="Project photos">
      <Image class="c-wide" src={p1} alt="2x pantograph on an optical breadboard" widths={[500, 800]} sizes="(max-width: 900px) 100vw, 40vw" />
      <Image src={p2} alt="3D printed wind turbine" widths={[300, 500]} sizes="(max-width: 900px) 50vw, 20vw" />
      <Image src={p3} alt="Rube Goldberg machine" widths={[300, 500]} sizes="(max-width: 900px) 50vw, 20vw" />
      <Image src={p4} alt="Testing the water filter" widths={[300, 500]} sizes="(max-width: 900px) 50vw, 20vw" />
      <Image src={p5} alt="Junior robotics at Punahou School" widths={[300, 500]} sizes="(max-width: 900px) 50vw, 20vw" />
    </div>
  </section>
</BaseLayout>

<style>
  .centered { justify-content: center; margin-top: 24px; }
  .resume-grid { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr); gap: 28px; padding-bottom: 96px; align-items: start; }
  @media (max-width: 900px) { .resume-grid { grid-template-columns: 1fr; } }
  .paper { display: block; background: #fff; border: 1px solid var(--mist); border-radius: 2px; box-shadow: 0 22px 44px -28px rgba(37, 52, 71, 0.45); transition: transform 0.3s var(--ease), box-shadow 0.3s var(--ease); }
  .paper:hover { transform: translateY(-2px); box-shadow: 0 28px 52px -28px rgba(37, 52, 71, 0.55); }
  .paper :global(img) { width: 100%; height: auto; }
  .collage { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
  .collage :global(img) { width: 100%; height: 100%; aspect-ratio: 1; object-fit: cover; border-radius: 2px; }
  .collage :global(.c-wide) { grid-column: span 2; aspect-ratio: 16 / 10; }
</style>
